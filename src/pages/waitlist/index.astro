---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import WaitlistCard from "@components/WaitlistCard.astro";
import { WAITLIST } from "@consts";
import { sortByDateTimeDesc } from "@lib/utils";

const data = (await getCollection("waitlist", (_) => !_.data.draft)) //
  .sort(sortByDateTimeDesc);
---

<Layout title={WAITLIST.TITLE} description={WAITLIST.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div class="space-y-4">
          {
            data.length > 0 ? (
              <div class="grid grid-cols-1 gap-4">
                {data.map(({ id, data }) => (
                  <WaitlistCard href={`/waitlist/${id}`} {...data} />
                ))}
              </div>
            ) : (
              <p class="text-black/60 dark:text-white/60">
                No waitlist items available at the moment.
              </p>
            )
          }
        </div>
      </div>
    </aside>
  </Container>
</Layout>

<script>
  function generateRandomPastelColor() {
    const hue = Math.floor(Math.random() * 360);
    const saturation = Math.floor(Math.random() * 30) + 10;
    const lightness = Math.floor(Math.random() * 20) + 70;
    return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
  }

  // Apply random colors to cards with random-bg-card class
  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll(".random-bg-card");
    cards.forEach((card) => {
      (card as HTMLElement).style.backgroundColor = generateRandomPastelColor();
    });
  });
</script>

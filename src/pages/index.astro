---
import Layout from "@layouts/Layout.astro";
import Upstream from "@components/Upstream.astro";
import WorkSection from "@components/WorkSection.astro";
import LogList from "@components/LogList.astro";
import { HOME, SITE } from "@consts";
import { getCollection } from "astro:content";
import { createLogItems } from "@lib/log";
import { publishedWorks } from "@lib/works";

const [allWorks, allPosts, notes] = await Promise.all([
  getCollection("works"),
  getCollection("posts"),
  getCollection("notes"),
]);
const works = publishedWorks(allWorks);
const posts = allPosts.filter((post) => !post.data.draft);
const logEntries = createLogItems(posts, notes, works).slice(0, 4);
---

<Layout title="Home" description={HOME.DESCRIPTION}>
  <section class="hero" id="about">
    <h1>
      Quino <i>Terrasa</i><button
        class="stop"
        type="button"
        data-egg
        aria-label="Open the back room"
        aria-controls="egg"
        aria-expanded="false">.</button
      >
    </h1>
    <p class="role">Product &amp; Forward-Deployed Engineer</p>
    <p class="thesis">
      I take AI ideas from a real user problem to a shipped product:
      <em>agents</em>, <em>on-device models</em> and
      <em>tools developers install</em>. Some ship in a weekend, some run for
      months. All of it is on this page.
    </p>
    <div class="avail">
      <a
        class="button"
        href={`mailto:${SITE.EMAIL}`}
        data-track="reach_out_cta"
      >
        Reach out
      </a>
      <a
        class="text-link"
        href={SITE.NEWSLETTER_URL}
        data-track="newsletter_cta"
      >
        or read the newsletter
      </a>
    </div>
  </section>

  <Upstream />
  <WorkSection works={works} />

  <section id="log" class="log-section">
    <div class="section-head">
      <h2>Log</h2>
      <a href="/log/">All entries →</a>
    </div>
    <p class="anno">
      Entries combine owner-written notes from content/notes and posts from
      content/blog. Notes stay inline; posts link to /log/[id]. Featured posts
      carry a star.
    </p>
    <LogList entries={logEntries} />
  </section>
</Layout>

<style>
  .hero {
    max-width: 640px;
    padding: 96px 0 28px;
  }

  .hero h1 {
    margin: 0;
    font: 700 42px/1.02 var(--display);
    letter-spacing: -0.035em;
  }

  .hero h1 i {
    color: var(--accent);
    font-style: normal;
  }

  .role {
    margin: 6px 0 18px;
    color: var(--muted-strong);
    font-weight: 500;
  }

  .thesis {
    margin: 0;
    color: var(--fg-soft);
    font-size: 17px;
    line-height: 1.6;
  }

  .thesis em {
    color: var(--fg);
    font-style: normal;
    font-weight: 600;
  }

  .avail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin-top: 22px;
  }

  .button {
    display: inline-flex;
    height: 38px;
    align-items: center;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 13px;
    font-weight: 600;
    transition: transform 0.25s var(--spring);
  }

  .button:active {
    transform: scale(0.97);
  }

  .text-link {
    border-bottom: 1px solid var(--border-strong);
    color: var(--muted-strong);
    font-size: 13px;
    font-weight: 600;
  }

  .text-link:hover {
    color: var(--fg);
  }

  .stop {
    display: inline-block;
    padding: 0 0 0 1px;
    border: 0;
    background: none;
    color: var(--accent);
    cursor: pointer;
    font: inherit;
    transition: transform 0.4s var(--spring);
  }

  .stop:hover,
  .stop[aria-expanded="true"] {
    transform: translateY(-3px) scale(1.25);
  }

  .stop.hint {
    animation: hint 1.1s 1 both;
  }

  @keyframes hint {
    0%,
    100% {
      transform: none;
    }

    30% {
      transform: translateY(-6px);
    }

    55% {
      transform: none;
    }

    70% {
      transform: translateY(-2px);
    }
  }

  .log-section {
    padding: 34px 0 8px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    color: var(--fg);
    font: 650 22px/1.1 var(--display);
    letter-spacing: -0.02em;
  }

  .section-head > a {
    color: var(--muted-strong);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .section-head > a:hover {
    color: var(--fg);
  }

  @media (min-width: 760px) {
    .hero {
      padding: 128px 0 36px;
    }

    .hero h1 {
      font-size: 60px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stop {
      transition: none;
    }

    .stop.hint {
      animation: none;
    }
  }
</style>

---
import Layout from "@layouts/Layout.astro";
import Marquee from "@components/Marquee.astro";
import GlassRow from "@components/GlassRow.astro";
import WorkRow from "@components/WorkRow.astro";
import ActivitySection from "@components/ActivitySection.astro";
import CurrentlyWorkingOn from "@components/CurrentlyWorkingOn.astro";
import { getCollection } from "astro:content";
import { sortByDateTimeDesc } from "@lib/utils";
import { currentProjects, ossTools } from "@data/landing-data";

const allPosts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort(sortByDateTimeDesc);

const posts = allPosts.slice(0, 2);

const allWork = (await getCollection("work")).sort(sortByDateTimeDesc);
const work = allWork.slice(0, 2);

/**
 * @deprecated Move to a separate component
 */
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

/**
 * @deprecated Move to a separate component
 */
function formatShortDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
}
---

<Layout title="Home" description="Quino Terrasa - Full-Stack Engineer">
  <div class="flex flex-col gap-6">
    <!-- Section 1: Bio Intro -->
    <section class="bio animate flex flex-col gap-4">
      <h1 class="text-fg text-[30px] font-bold leading-tight">Hey, I'm Quino</h1>
      <p class="text-fg text-[15px] leading-[1.7]">
        I build products from 0 to 1 — combining AI engineering and full-stack
        product craft to ship mobile and web experiences that feel great and work
        brilliantly. Product Engineer, AI Engineer, maker.
      </p>
      <Marquee />
    </section>

    <!-- Section 2: Currently Working On -->
    <section class="projects-preview animate">
      <CurrentlyWorkingOn projects={currentProjects} ossTools={ossTools} />
    </section>

    <!-- Section 3: Activity -->
    <ActivitySection />

    <!-- Section 4: Posts Preview -->
    <section class="posts-preview animate flex flex-col gap-4">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-fg text-[19px] font-semibold">Posts</h2>
        <a
          href="/posts"
          class="text-muted hover:text-accent text-[13px] no-underline transition-colors duration-300"
          >View all posts →</a
        >
      </div>
      <div class="flex flex-col gap-2">
        {
          posts.length > 0 ? (
            posts.map((post) => (
              <GlassRow
                date={formatDate(post.data.date)}
                title={post.data.title}
                href={`/posts/${post.id}`}
              />
            ))
          ) : (
            <p class="text-muted text-[13px] italic">No posts yet.</p>
          )
        }
      </div>
    </section>

    <!-- Section 5: Work Preview -->
    {
      allWork.length > 0 && (
        <section class="work-preview animate flex flex-col gap-4">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-fg text-[19px] font-semibold">Work</h2>
            <a
              href="/work"
              class="text-muted hover:text-accent text-[13px] no-underline transition-colors duration-300"
            >
              View all work →
            </a>
          </div>
          <div class="flex flex-col gap-2">
            {work.length > 0 ? (
              work.map((item) => (
                <WorkRow
                  date={formatShortDate(item.data.date)}
                  title={item.data.title}
                  href={item.data.url}
                />
              ))
            ) : (
              <p class="text-muted text-[13px] italic">No work entries yet.</p>
            )}
          </div>
        </section>
      )
    }
  </div>
</Layout>

---
import Layout from "@layouts/Layout.astro";
import Marquee from "@components/Marquee.astro";
import GlassRow from "@components/GlassRow.astro";
import GlassCard from "@components/GlassCard.astro";
import ActivitySection from "@components/ActivitySection.astro";
import { getCollection } from "astro:content";

// Fetch and sort collections
const allPosts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const posts = allPosts.slice(0, 2);

const allWork = (await getCollection("work")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const work = allWork.slice(0, 2);

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const projects = allProjects.slice(0, 2);

// Format date for display
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });
}
---

<Layout title="Home" description="Quino Terrasa - Full-Stack Engineer">
  <div class="home">
    <!-- Section 1: Bio Intro -->
    <section class="section bio animate">
      <p class="bio-text">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
        eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad
        minim veniam, quis nostrud exercitation ullamco laboris nisi ut
        aliquip ex ea commodo consequat. Duis aute irure dolor in
        reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla
        pariatur.
      </p>
    </section>

    <!-- Section 2: Marquee Quote -->
    <section class="section marquee-section">
      <Marquee />
    </section>

    <!-- Section 3: Posts Preview -->
    <section class="section posts-preview animate">
      <div class="section-header">
        <h2 class="section-title">Posts</h2>
        <a href="/posts" class="view-all">View all posts →</a>
      </div>
      <div class="section-content">
        {
          posts.length > 0 ? (
            posts.map((post) => (
              <GlassRow
                date={formatDate(post.data.date)}
                title={post.data.title}
                href={`/posts/${post.id}`}
              />
            ))
          ) : (
            <p class="empty-state">No posts yet.</p>
          )
        }
      </div>
    </section>

    <!-- Section 4: Work Preview -->
    <section class="section work-preview animate">
      <div class="section-header">
        <h2 class="section-title">Work</h2>
        <a href="/work" class="view-all">View all work →</a>
      </div>
      <div class="section-content">
        {
          work.length > 0 ? (
            work.map((item) => (
              <GlassRow
                date={formatDate(item.data.date)}
                title={item.data.title}
                href={item.data.url}
              />
            ))
          ) : (
            <p class="empty-state">No work entries yet.</p>
          )
        }
      </div>
    </section>

    <!-- Section 5: Projects Preview -->
    <section class="section projects-preview animate">
      <div class="section-header">
        <h2 class="section-title">Projects</h2>
        <a href="/projects" class="view-all">View all projects →</a>
      </div>
      <div class="section-content">
        {
          projects.length > 0 ? (
            projects.map((project) => (
              <GlassCard href={project.data.url}>
                <h3 class="project-title">{project.data.title}</h3>
                <p class="project-description">{project.data.description}</p>
              </GlassCard>
            ))
          ) : (
            <p class="empty-state">No projects yet.</p>
          )
        }
      </div>
    </section>

    <!-- Section 6: Activity Section -->
    <ActivitySection />
  </div>
</Layout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .section-title {
    font-size: var(--size-h2);
    font-weight: 600;
    color: var(--fg);
  }

  .view-all {
    font-size: var(--size-meta);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s var(--easing);
  }

  .view-all:hover {
    color: var(--accent);
  }

  .section-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Bio section */
  .bio-text {
    font-size: var(--size-body);
    color: var(--fg);
    line-height: 1.7;
  }

  /* Marquee section */
  .marquee-section {
    margin-block: var(--space-2);
  }

  /* Project card content */
  .project-title {
    font-size: var(--size-body);
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-1);
  }

  .project-description {
    font-size: var(--size-meta);
    color: var(--muted);
    line-height: 1.5;
  }

  /* Empty and placeholder states */
  .empty-state,
  .placeholder-text {
    font-size: var(--size-meta);
    color: var(--muted);
    font-style: italic;
  }
</style>

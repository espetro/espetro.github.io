---
import Layout from "@layouts/Layout.astro";
import Marquee from "@components/Marquee.astro";
import GlassRow from "@components/GlassRow.astro";
import WorkRow from "@components/WorkRow.astro";
import ActivitySection from "@components/ActivitySection.astro";
import { getCollection } from "astro:content";
import ProjectCategorySection from "@components/ProjectCategorySection.astro";
import { sortByDateTimeDesc } from "@lib/utils";

// Fetch and sort collections
const allPosts = (await getCollection("posts")) //
  .sort(sortByDateTimeDesc);

const posts = allPosts.slice(0, 2);

const allWork = (await getCollection("work")) //
  .sort(sortByDateTimeDesc);
const work = allWork.slice(0, 2);

const allProjects = (await getCollection("projects")) //
  .filter((p) => !p.data.draft)
  .sort(sortByDateTimeDesc);

const frontBurner = allProjects.filter(
  (p) => p.data.category === "front-burner",
);

/**
 * Format date for display (short month + day + full year)
 * @deprecated Move to a separate component in style of ProjectCategorySection and ProjectCard
 *  */
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

/**
 * Format date for work (short month + day)
 * @deprecated Move to a separate component in style of ProjectCategorySection and ProjectCard
 *  */
function formatShortDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
}
---

<Layout title="Home" description="Quino Terrasa - Full-Stack Engineer">
  <div class="flex flex-col gap-6">
    <!-- Section 1: Bio Intro + Quote -->
    <section class="bio animate flex flex-col gap-4">
      <h1 class="sr-only">Quino Terrasa — Senior AI Engineer</h1>
      <p class="text-fg text-[15px] leading-[1.7]">
        I'm a Senior AI Engineer working at the intersection of agentic systems
        and full-stack product engineering, from architecture decisions to
        shipped mobile and web experiences. This is my corner of the web where
        you can find what I'm currently tinkering with and where I share my
        thoughts.
      </p>
      <Marquee />
    </section>

    <!-- Section 3: Posts Preview -->
    <section class="posts-preview animate flex flex-col gap-4">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-fg text-[19px] font-semibold">Posts</h2>
        <a
          href="/posts"
          class="text-muted hover:text-accent text-[13px] no-underline transition-colors duration-300"
          >View all posts →</a
        >
      </div>
      <div class="flex flex-col gap-2">
        {
          posts.length > 0 ? (
            posts.map((post) => (
              <GlassRow
                date={formatDate(post.data.date)}
                title={post.data.title}
                href={`/posts/${post.id}`}
              />
            ))
          ) : (
            <p class="text-muted text-[13px] italic">No posts yet.</p>
          )
        }
      </div>
    </section>

    <!-- Section 4: Work Preview -->
    {
      allWork.length > 0 && (
        <section class="work-preview animate flex flex-col gap-4">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-fg text-[19px] font-semibold">Work</h2>
            <a
              href="/work"
              class="text-muted hover:text-accent text-[13px] no-underline transition-colors duration-300"
            >
              View all work →
            </a>
          </div>
          <div class="flex flex-col gap-2">
            {work.length > 0 ? (
              work.map((item) => (
                <WorkRow
                  date={formatShortDate(item.data.date)}
                  title={item.data.title}
                  href={item.data.url}
                />
              ))
            ) : (
              <p class="text-muted text-[13px] italic">No work entries yet.</p>
            )}
          </div>
        </section>
      )
    }

    <!-- Section 5: Projects Preview -->
    <section class="projects-preview animate flex flex-col gap-4">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-fg text-[19px] font-semibold">Projects</h2>
        <a
          href="/projects"
          class="text-muted hover:text-accent text-[13px] no-underline transition-colors duration-300"
          >View all projects →</a
        >
      </div>
      <div class="flex flex-col gap-2">
        {
          frontBurner.length > 0 ? (
            <ProjectCategorySection projects={frontBurner} id="front-burner" />
          ) : (
            // TODO show back-burner and retired projects in GlassRow style
            <p class="text-muted text-[13px] italic">No projects yet.</p>
          )
        }
      </div>
    </section>

    <!-- Section 6: Activity Section -->
    <ActivitySection />
  </div>
</Layout>

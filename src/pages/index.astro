---
import Layout from "@layouts/Layout.astro";
import Marquee from "@components/Marquee.astro";
import GlassRow from "@components/GlassRow.astro";
import GlassCard from "@components/GlassCard.astro";
import WorkRow from "@components/WorkRow.astro";
import ActivitySection from "@components/ActivitySection.astro";
import { getCollection } from "astro:content";

// Fetch and sort collections
const allPosts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const posts = allPosts.slice(0, 2);

const allWork = (await getCollection("work")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const work = allWork.slice(0, 2);

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const projects = allProjects.slice(0, 2);

// Format date for display (short month + day + full year)
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

// Format date for work (short month + day)
function formatShortDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
}

// Status pill styles
const STATUS_PILLS: Record<string, { bg: string; text: string; label: string }> = {
  "front-burner": { bg: "var(--accent-soft)", text: "var(--accent)", label: "FRONT BURNER" },
  "back-burner": { bg: "rgba(234, 179, 8, 0.1)", text: "rgb(234, 179, 8)", label: "BACK BURNER" },
  retired: { bg: "rgba(107, 114, 128, 0.1)", text: "rgb(107, 114, 128)", label: "RETIRED" },
};

function getStatusPill(status: string) {
  return STATUS_PILLS[status] ?? STATUS_PILLS["retired"];
}
---

<Layout title="Home" description="Quino Terrasa - Full-Stack Engineer">
  <div class="home">
    <!-- Section 1: Bio Intro + Quote -->
    <section class="section bio animate">
      <p class="bio-text">
        I'm a Senior AI Engineer working at the intersection of agentic systems and full-stack product engineering, from architecture decisions to shipped mobile and web experiences. This is my corner of the web where you can find what I'm currently tinkering with and where I share my thoughts.
      </p>
      <Marquee />
    </section>

    <!-- Section 3: Posts Preview -->
    <section class="section posts-preview animate">
      <div class="section-header">
        <h2 class="section-title">Posts</h2>
        <a href="/posts" class="view-all">View all posts →</a>
      </div>
      <div class="section-content">
        {
          posts.length > 0 ? (
            posts.map((post) => (
              <GlassRow
                date={formatDate(post.data.date)}
                title={post.data.title}
                href={`/posts/${post.id}`}
              />
            ))
          ) : (
            <p class="empty-state">No posts yet.</p>
          )
        }
      </div>
    </section>

    <!-- Section 4: Work Preview -->
    {allWork.length > 0 && (
    <section class="section work-preview animate">
      <div class="section-header">
        <h2 class="section-title">Work</h2>
        <a href="/work" class="view-all">View all work →</a>
      </div>
      <div class="section-content">
        {
          work.length > 0 ? (
            work.map((item) => (
              <WorkRow
                date={formatShortDate(item.data.date)}
                title={item.data.title}
                href={item.data.url}
              />
            ))
          ) : (
            <p class="empty-state">No work entries yet.</p>
          )
        }
      </div>
    </section>
    )}

    <!-- Section 5: Projects Preview -->
    <section class="section projects-preview animate">
      <div class="section-header">
        <h2 class="section-title">Projects</h2>
        <a href="/projects" class="view-all">View all projects →</a>
      </div>
      <div class="section-content">
        {
          projects.length > 0 ? (
            projects.map((project) => {
              const pill = getStatusPill(project.data.status);
              return (
                <GlassCard href={project.data.url} class="project-card">
                  <div class="project-card-inner">
                    <div class="project-card-header">
                      <span
                        class="project-status-pill"
                        style={`background-color: ${pill.bg}; color: ${pill.text};`}
                      >
                        {pill.label}
                      </span>
                    </div>
                    <h3 class="project-title">{project.data.title}</h3>
                    <p class="project-description">{project.data.description}</p>
                    {project.data.tech && project.data.tech.length > 0 && (
                      <div class="project-tech-tags">
                        {project.data.tech.map((t: string) => (
                          <span class="project-tech-tag">{t}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </GlassCard>
              );
            })
          ) : (
            <p class="empty-state">No projects yet.</p>
          )
        }
      </div>
    </section>

    <!-- Section 6: Activity Section -->
    <ActivitySection />
  </div>
</Layout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .section-title {
    font-size: var(--size-h2);
    font-weight: 600;
    color: var(--fg);
  }

  .view-all {
    font-size: var(--size-meta);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s var(--easing);
  }

  .view-all:hover {
    color: var(--accent);
  }

  .section-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Bio section */
  .bio-text {
    font-size: var(--size-body);
    color: var(--fg);
    line-height: 1.7;
  }

  /* Project card content */
  .project-card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-card-header {
    display: flex;
    align-items: center;
  }

  .project-status-pill {
    display: inline-block;
    border-radius: 9999px;
    padding: 0.125rem 0.5rem;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-title {
    font-size: var(--size-body);
    font-weight: 600;
    color: var(--fg);
  }

  .project-description {
    font-size: var(--size-meta);
    color: var(--muted);
    line-height: 1.5;
  }

  .project-tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .project-tech-tag {
    border-radius: var(--radius-sm);
    padding: 0.125rem 0.375rem;
    font-size: 10px;
    background-color: var(--bg-elevated);
    color: var(--muted);
  }

  /* Empty and placeholder states */
  .empty-state,
  .placeholder-text {
    font-size: var(--size-meta);
    color: var(--muted);
    font-style: italic;
  }
</style>

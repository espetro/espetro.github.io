---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import GlassRow from "@components/GlassRow.astro";
import NewsletterCallout from "@components/NewsletterCallout.astro";
import { getCollection } from "astro:content";
import { sortByDateTimeDesc } from "@lib/utils";

const posts = (await getCollection("posts")) //
  .filter((p) => !p.data.draft)
  .sort(sortByDateTimeDesc);

const groups = Object.groupBy(posts, ({ data }) =>
  data.date.getFullYear().toString(),
);

const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Posts" description="All blog posts">
  <div class="flex flex-col gap-8">
    <PageHeader title="Posts">
      <p class="m-0 text-[15px] leading-relaxed text-[var(--fg-soft)]">
        Notes and essays on tech, UX, and agentic design. For experiments and
        shipped projects, see <a
          href="/projects"
          style="color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);"
          >Projects</a
        >.
      </p>
    </PageHeader>

    <NewsletterCallout />

    {
      years.map((year) => (
        <section class="flex flex-col gap-4">
          <h2 class="text-[11px] tracking-[0.08em] text-[var(--muted)] uppercase">
            {year}
          </h2>
          <div class="flex flex-col gap-2">
            {groups?.[year]?.map((post) => (
              <GlassRow
                date={post.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "2-digit",
                })}
                title={post.data.title}
                href={`/posts/${post.id}`}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>

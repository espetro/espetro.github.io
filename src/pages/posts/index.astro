---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import GlassRow from "@components/GlassRow.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const sorted = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const limited = sorted.slice(0, 2);

const groups = limited.reduce<Record<string, typeof limited>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Posts" description="All blog posts">
  <div class="flex flex-col gap-8">
    <PageHeader title="Posts">
      <p class="m-0 text-[15px] leading-relaxed text-[var(--fg-soft)]">
        Notes and essays on tech, UX, and agentic design. For experiments and
        shipped projects, see <a
          href="/projects"
          style="color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);"
          >Projects</a
        >.
      </p>
    </PageHeader>

    {
      years.map((year) => (
        <section class="flex flex-col gap-4">
          <h2 class="text-[11px] tracking-[0.08em] text-[var(--muted)] uppercase">
            {year}
          </h2>
          <div class="flex flex-col gap-2">
            {groups[year].map((post) => (
              <GlassRow
                date={post.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "2-digit",
                })}
                title={post.data.title}
                href={`/posts/${post.id}`}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>

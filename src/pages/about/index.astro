---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

const HOME = {
  TITLE: "About",
  DESCRIPTION: "About — experience, interests, and what drives me",
};

interface Experience {
  company: string;
  role: string;
  period: string;
  description: string;
}

const experience: Record<string, Experience[]> = {
  Current: [
    {
      company: "MaibornWolff GmbH",
      role: "Senior AI Engineer",
      period: "Jun 2022 - Present",
      description:
        "AI gateway architect for Rohde & Schwarz (K8s, TypeScript, Rust) and HWZ University (NextJS, Azure AI). Built data platforms for Liebherr (Go, Python) and doubled CI/CD speed at Volkswagen (AWS, TypeScript).",
    },
  ],
  Past: [
    {
      company: "StratioBD",
      role: "Big Data Engineer",
      period: "Nov 2021 - Jun 2022",
      description:
        "Modernized build tooling (Java 11, Scala 2.12), cutting build times 40% and rollout times 20%. Mentored team on scalable Spark optimizations.",
    },
    {
      company: "Tupl Inc.",
      role: "Software Engineer",
      period: "Aug 2020 - Nov 2021",
      description:
        "Co-owned a third of the startup platform (React, http4s, Akka) serving Spain, US, and Japan. Reduced API surface by 20% through functional and type-system best practices.",
    },
  ],
};
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="mb-10 flex justify-center">
      <div class="h-70 w-70">
        <div
          class="photo-wrapper group relative h-full w-full overflow-hidden rounded-lg"
        >
          <img
            src="/profile.jpg"
            alt="Profile photo"
            class="absolute inset-0 h-full w-full object-cover [transition:opacity_0.4s_var(--easing)] group-hover:opacity-0"
          />
          <img
            src="/avatar.jpg"
            alt="Avatar"
            class="absolute inset-0 h-full w-full object-cover opacity-0 [transition:opacity_0.4s_var(--easing)] group-hover:opacity-100"
          />
        </div>
      </div>
    </section>

    <section class="bio-section animate mb-10">
      <h2 class="text-fg mb-4 font-semibold text-(--font-size-h2)">
        Beyond Work
      </h2>
      <p class="text-fg-soft leading-relaxed text-(--font-size-body)">
        I'm always learning a new language — right now Arabic, after Portuguese,
        Italian, and Catalan. I love trying unfamiliar food, especially anything
        spicy, and then figuring out how to cook it at home. Most of my side
        projects start as something I (or my family and friends) actually need.
      </p>
    </section>

    <section class="animate mt-16">
      <h2 class="mb-6 font-semibold text-(--font-size-h2)">Experience</h2>

      {
        Object.entries(experience).map(([label, items]) => (
          <div class="mb-8">
            <h3 class="mb-2 font-semibold tracking-wider text-(--font-size-meta) uppercase">
              {label}
            </h3>
            <div class="overflow-hidden rounded-[14px] border border-(--border) bg-(--bg)">
              {items.map((item, i) => (
                <>
                  <div class="p-6">
                    <span class="mb-1 block font-mono text-[11px] tracking-wider text-(--muted) uppercase">
                      {item.period}
                    </span>
                    <h4 class="mb-1 font-semibold text-(--fg)">
                      {item.company}
                    </h4>
                    <p class="mb-2 font-medium text-(--fg-soft)">{item.role}</p>
                    <p class="leading-relaxed text-(--fg-soft)">
                      {item.description}
                    </p>
                  </div>
                  {i < items.length - 1 && (
                    <hr class="m-0 border-0 border-t border-(--border)" />
                  )}
                </>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </Container>
</Layout>

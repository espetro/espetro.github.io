---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BioSection from "@components/BioSection.astro";

const HOME = {
  TITLE: "About",
  DESCRIPTION: "About — experience, interests, and what drives me",
};

const experience = {
  current: [
    {
      company: "MaibornWolff GmbH",
      role: "Senior AI Engineer",
      period: "Jun 2022 - Present",
      description:
        "AI gateway architect for Rohde & Schwarz (K8s, TypeScript, Rust) and HWZ University (NextJS, Azure AI). Built data platforms for Liebherr (Go, Python) and doubled CI/CD speed at Volkswagen (AWS, TypeScript).",
    },
  ],
  past: [
    {
      company: "StratioBD",
      role: "Big Data Engineer",
      period: "Nov 2021 - Jun 2022",
      description:
        "Modernized build tooling (Java 11, Scala 2.12), cutting build times 40% and rollout times 20%. Mentored team on scalable Spark optimizations.",
    },
    {
      company: "Tupl Inc.",
      role: "Software Engineer",
      period: "Aug 2020 - Nov 2021",
      description:
        "Co-owned a third of the startup platform (React, http4s, Akka) serving Spain, US, and Japan. Reduced API surface by 20% through functional and type-system best practices.",
    },
  ],
};
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="about-hero">
      <div class="photo-container">
        <div class="photo-wrapper">
          <img
            src="/profile.jpg"
            alt="Profile photo"
            class="photo"
          />
          <img
            src="/avatar.jpg"
            alt="Avatar"
            class="avatar"
          />
        </div>
      </div>
    </section>

    <BioSection title="Beyond Work">
      <p>
        I'm always learning a new language — right now Arabic, after Portuguese,
        Italian, and Catalan. I love trying unfamiliar food, especially anything
        spicy, and then figuring out how to cook it at home. Most of my side
        projects start as something I (or my family and friends) actually need.
      </p>
    </BioSection>

    <section class="experience-section animate">
      <h2>Experience</h2>
      <div class="experience-card">
        {
          [...experience.current, ...experience.past].map((item, index, arr) => (
            <>
              <div class="experience-entry">
                <span class="experience-period">{item.period}</span>
                <h3 class="experience-company">{item.company}</h3>
                <p class="experience-role">{item.role}</p>
                <p class="experience-description">{item.description}</p>
              </div>
              {index < arr.length - 1 && <hr class="experience-divider" />}
            </>
          ))
        }
      </div>
    </section>
  </Container>
</Layout>

<style>
  .about-hero {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-5);
  }

  .photo-container {
    width: 280px;
    height: 280px;
  }

  .photo-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .photo,
  .avatar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--easing), opacity 0.4s var(--easing);
  }

  .avatar {
    opacity: 0;
    transform: scale(0.9);
  }

  .photo-wrapper:hover .photo {
    transform: scale(0.85);
    opacity: 0;
  }

  .photo-wrapper:hover .avatar {
    opacity: 1;
    transform: scale(1);
  }

  .experience-section {
    margin-top: var(--space-6);
  }

  .experience-section > h2 {
    font-size: var(--size-h2);
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--fg);
  }

  .experience-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg);
  }

  .experience-entry {
    padding: var(--space-4);
  }

  .experience-period {
    font-family: ui-monospace, monospace;
    font-size: var(--size-micro);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-1);
  }

  .experience-company {
    font-size: var(--size-h3);
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-1);
  }

  .experience-role {
    font-size: var(--size-meta);
    font-weight: 500;
    color: var(--fg-soft);
    margin-bottom: var(--space-2);
  }

  .experience-description {
    font-size: var(--size-body);
    color: var(--fg-soft);
    line-height: 1.6;
  }

  .experience-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0;
  }
</style>
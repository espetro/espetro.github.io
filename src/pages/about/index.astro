---
import Layout from "@layouts/Layout.astro";
import Speaking from "@components/Speaking.astro";
import { SITE } from "@consts";

interface Experience {
  company: string;
  role: string;
  period: string;
  description: string;
}

const experience: Record<string, Experience[]> = {
  Current: [
    {
      company: "MaibornWolff GmbH",
      role: "Senior AI Engineer",
      period: "Jun 2022 - Present",
      description:
        "AI gateway architect for Rohde & Schwarz (K8s, TypeScript, Rust) and HWZ University (NextJS, Azure AI). Built data platforms for Liebherr (Go, Python) and doubled CI/CD speed at Volkswagen (AWS, TypeScript).",
    },
  ],
  Past: [
    {
      company: "StratioBD",
      role: "Big Data Engineer",
      period: "Nov 2021 - Jun 2022",
      description:
        "Modernized build tooling (Java 11, Scala 2.12), cutting build times 40% and rollout times 20%. Mentored team on scalable Spark optimizations.",
    },
    {
      company: "Tupl Inc.",
      role: "Software Engineer",
      period: "Aug 2020 - Nov 2021",
      description:
        "Co-owned a third of the startup platform (React, http4s, Akka) serving Spain, US, and Japan. Reduced API surface by 20% through functional and type-system best practices.",
    },
  ],
};
---

<Layout
  title="About"
  description="About — experience, interests, and what drives me"
>
  <div class="about">
    <a class="back" href="/">← Home</a>
    <section class="photos" aria-label="Portrait">
      <div class="photo-wrapper">
        <img src="/profile.jpg" alt="Quino Terrasa" />
        <img class="avatar" src="/avatar.jpg" alt="Illustrated avatar" />
      </div>
    </section>

    <section class="bio-section">
      <h1>About</h1>
      <h2>Beyond Work</h2>
      <p>
        I'm always learning a new language — right now Arabic, after Portuguese,
        Italian, and Catalan. I love trying unfamiliar food, especially anything
        spicy, and then figuring out how to cook it at home. Most of my side
        projects start as something I (or my family and friends) actually need.
      </p>
    </section>

    <section class="experience-section">
      <h2>Experience</h2>
      {
        Object.entries(experience).map(([label, items]) => (
          <div class="experience-group">
            <h3>{label}</h3>
            <div class="experience">
              {items.map((item) => (
                <article>
                  <time>{item.period}</time>
                  <h4>{item.company}</h4>
                  <p class="role">{item.role}</p>
                  <p>{item.description}</p>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </section>
    {SITE.SHOW_SPEAKING && <Speaking />}
  </div>
</Layout>

<style>
  .about {
    max-width: 720px;
    padding-top: 96px;
  }

  .back {
    color: var(--muted-strong);
    font-size: 13px;
    font-weight: 600;
  }

  .back:hover {
    color: var(--fg);
  }

  .photos {
    display: flex;
    justify-content: center;
    margin: 26px 0 42px;
  }

  .photo-wrapper {
    position: relative;
    width: 240px;
    height: 240px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-elevated);
  }

  .photo-wrapper img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s var(--easing);
  }

  .photo-wrapper .avatar {
    opacity: 0;
  }

  .photo-wrapper:hover .avatar {
    opacity: 1;
  }

  .photo-wrapper:hover img:first-child {
    opacity: 0;
  }

  h1,
  .experience-section > h2 {
    margin: 0 0 16px;
    font: 700 30px/1.1 var(--display);
    letter-spacing: -0.03em;
  }

  .bio-section h2 {
    margin: 0 0 8px;
    font: 650 20px/1.2 var(--display);
  }

  .bio-section p,
  .experience article > p {
    margin: 0;
    color: var(--fg-soft);
    font-size: 15px;
    line-height: 1.7;
  }

  .experience-section {
    margin-top: 56px;
  }

  .experience-group {
    margin-top: 28px;
  }

  .experience-group > h3 {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience {
    border-top: 1px solid var(--border);
  }

  .experience article {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .experience time {
    color: var(--muted);
    font: 500 11px var(--text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .experience h4 {
    margin: 5px 0 1px;
    font: 650 17px var(--display);
  }

  .experience article > p.role {
    margin-bottom: 8px;
    color: var(--fg);
    font-weight: 600;
  }

  @media (min-width: 760px) {
    .photo-wrapper {
      width: 280px;
      height: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-wrapper img {
      transition: none;
    }
  }
</style>

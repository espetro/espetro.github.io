---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import Link from "@components/Link.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({ params: { id: project.id }, props: project }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await render(project);

const formatStarted = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const STATUS_STYLES: Record<string, { bg: string; text: string; label: string }> = {
  "front-burner": {
    bg: "var(--accent-soft)",
    text: "var(--accent)",
    label: "FRONT BURNER",
  },
  "back-burner": {
    bg: "rgba(234, 179, 8, 0.1)",
    text: "rgb(234, 179, 8)",
    label: "BACK BURNER",
  },
  retired: {
    bg: "rgba(107, 114, 128, 0.1)",
    text: "rgb(107, 114, 128)",
    label: "RETIRED",
  },
};

const status = project.data.category as keyof typeof STATUS_STYLES;
const pill = STATUS_STYLES[status] ?? STATUS_STYLES["retired"];
---

<Layout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="animate"><BackToPrevious href="/projects">Back to projects</BackToPrevious></div>

    <div class="project-header animate">
      <!-- Row 1: Title + Link chip -->
      <div class="header-top">
        <h1 class="project-title">{project.data.title}</h1>
        {project.data.link && (
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="link-chip"
          >
            <span class="link-chip-url">{new URL(project.data.link).hostname}</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2 10L10 2M10 2H4.5M10 2V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        )}
      </div>

      <!-- Row 2: Status pill + started date -->
      <div class="header-meta">
        <span
          class="status-pill"
          style={`background-color: ${pill.bg}; color: ${pill.text};`}
        >
          {pill.label}
        </span>
        <span class="started-date">Started {formatStarted(project.data.date)}</span>
      </div>

      <!-- Row 3: Value proposition -->
      <p class="value-proposition">{project.data.description}</p>
    </div>

    <!-- Preview image / gif -->
    {project.data.preview && (
      <div class="project-preview animate">
        <img
          src={project.data.preview}
          alt={`${project.data.title} preview`}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <!-- Article content -->
    <article class="animate content-spacing">
      <Content />
    </article>

  </Container>
</Layout>

<style>
  .project-header {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .header-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-title {
    font-size: var(--size-h1);
    font-weight: 700;
    line-height: 1.1;
    color: var(--fg);
    margin: 0;
  }

  .link-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--size-meta);
    white-space: nowrap;
    transition:
      background-color 0.2s var(--easing),
      border-color 0.2s var(--easing),
      color 0.2s var(--easing);
    flex-shrink: 0;
  }

  .link-chip:hover {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }

  .link-chip-url {
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .status-pill {
    display: inline-block;
    border-radius: 9999px;
    padding: 0.125rem 0.5rem;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .started-date {
    font-size: var(--size-meta);
    color: var(--muted);
  }

  .value-proposition {
    font-size: var(--size-body);
    color: var(--fg);
    line-height: 1.6;
    max-width: 65ch;
    margin: 0;
  }

  .project-preview {
    margin-bottom: 1.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .project-preview img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .content-spacing {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .reading-time {
    font-size: var(--size-meta);
    color: var(--muted);
    text-align: center;
    padding-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .header-top {
      flex-direction: column;
      gap: 0.5rem;
    }

    .link-chip {
      align-self: flex-start;
    }
  }
</style>

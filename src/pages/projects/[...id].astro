---
import { getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({
    params: { id: project.id },
    props: project,
  }));
}

const project = Astro.props;
const { Content } = await render(project);

const formatStarted = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const STATUS_STYLES: Record<
  string,
  { bg: string; text: string; label: string }
> = {
  "front-burner": {
    bg: "var(--accent-soft)",
    text: "var(--accent)",
    label: "FRONT BURNER",
  },
  "back-burner": {
    bg: "rgba(234, 179, 8, 0.1)",
    text: "rgb(234, 179, 8)",
    label: "BACK BURNER",
  },
  retired: {
    bg: "rgba(107, 114, 128, 0.1)",
    text: "rgb(107, 114, 128)",
    label: "RETIRED",
  },
};

const status = project.data.category as keyof typeof STATUS_STYLES;
const pill = STATUS_STYLES[status] ?? STATUS_STYLES["retired"];
---

<Layout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/projects">Back to projects</BackToPrevious>
    </div>

    <div class="animate mt-10 mb-6 flex flex-col gap-3">
      <!-- Row 1: Title + Link chip -->
      <div class="flex flex-wrap items-start justify-between gap-4 max-sm:flex-col max-sm:gap-2">
        <h1 class="m-0 text-[30px] font-bold leading-[1.1] text-(--fg)">
          {project.data.title}
        </h1>
        {
          project.data.link && (
            <a
              href={project.data.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-(--border) bg-(--bg-elevated) px-3 py-1.5 text-[13px] text-(--fg) no-underline whitespace-nowrap [transition:background-color_0.2s_var(--easing),border-color_0.2s_var(--easing),color_0.2s_var(--easing)] hover:border-(--accent) hover:bg-(--accent-soft) hover:text-(--accent) max-sm:self-start"
            >
              <span class="max-w-[180px] overflow-hidden text-ellipsis">
                {new URL(project.data.link).hostname}
              </span>
              <svg
                width="12"
                height="12"
                viewBox="0 0 12 12"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M2 10L10 2M10 2H4.5M10 2V7.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          )
        }
      </div>

      <!-- Row 2: Status pill + started date -->
      <div class="flex flex-wrap items-center gap-3">
        <span
          class="inline-block rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-[0.05em] uppercase"
          style={`background-color: ${pill.bg}; color: ${pill.text};`}
        >
          {pill.label}
        </span>
        <span class="text-[13px] text-(--muted)">
          Started {formatStarted(project.data.date)}
        </span>
      </div>

      <!-- Row 3: Value proposition -->
      <p class="m-0 max-w-[65ch] text-[15px] leading-[1.6] text-(--fg)">
        {project.data.description}
      </p>
    </div>

    <!-- Preview image / gif -->
    {
      project.data.preview && (
        <div class="animate mb-6 overflow-hidden rounded-[14px] border border-(--border)">
          <img
            src={project.data.preview}
            alt={`${project.data.title} preview`}
            loading="lazy"
            decoding="async"
            class="block h-auto w-full object-cover"
          />
        </div>
      )
    }

    <!-- Article content -->
    <article class="animate border-t border-(--border) pt-6 prose max-w-none">
      <Content />
    </article>
  </Container>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ProjectCategorySection from "@components/ProjectCategorySection.astro";
import { PROJECTS } from "@consts";
import { sortByDateTimeDesc } from "@lib/utils";
import PageHeader from "@components/PageHeader.astro";

const allProjects = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort(sortByDateTimeDesc);

const frontBurner = allProjects.filter(
  (p) => p.data.category === "front-burner",
);
const backBurner = allProjects.filter((p) => p.data.category === "back-burner");
const retired = allProjects.filter((p) => p.data.category === "retired");

const sectionDescriptions: Record<string, string> = {
  "front-burner": "Current focus—shipping and active builds.",
  "back-burner": `${backBurner.length} project${backBurner.length !== 1 ? "s" : ""} on the back burner—they may still continue.`,
  retired: `${retired.length} past project${retired.length !== 1 ? "s" : ""} from the archive.`,
};
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <div class="flex flex-col gap-8">
    <!-- Header -->
    <PageHeader title="Projects">
      <p class="text-(--fg-soft)">Apps and experiments—design, code, and AI.</p>
    </PageHeader>

    <ProjectCategorySection
      title="Front Burner"
      description={sectionDescriptions["front-burner"]}
      projects={frontBurner}
      id="front-burner"
    />

    <ProjectCategorySection
      title="Back Burner"
      description={sectionDescriptions["back-burner"]}
      projects={backBurner}
      id="back-burner"
    />

    <ProjectCategorySection
      title="Retired"
      description={sectionDescriptions["retired"]}
      projects={retired}
      id="retired"
    />
  </div>
</Layout>

---
import Layout from "@layouts/Layout.astro";
import GlassRow from "@components/GlassRow.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getCollection } from "astro:content";

const work = await getCollection("work");
const sorted = work.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const limited = sorted.slice(0, 2);

const groups = limited.reduce<Record<string, typeof limited>>((acc, item) => {
  const year = item.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {});

const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Work" description="Work history and experience">
  <div class="flex flex-col gap-8">
    <PageHeader title="Work">
      Selected posts from shipped sites and collaborations. Also see the full
      posts archive and projects.
    </PageHeader>
    {
      years.map((year) => (
        <section class="flex flex-col gap-4">
          <h2 class="text-[11px] tracking-[0.08em] text-[var(--muted)] uppercase">
            {year}
          </h2>
          <div class="flex flex-col gap-2">
            {groups[year].map((item) => (
              <GlassRow
                date={item.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                })}
                title={item.data.title}
                href={item.data.url}
                label={item.data.label}
              >
                {item.data.image && (
                  <img
                    src={item.data.image}
                    alt=""
                    class="h-10 w-10 rounded-[6px] border border-[var(--border)] object-cover"
                    loading="lazy"
                  />
                )}
              </GlassRow>
            ))}
          </div>
        </section>
      ))
    }

    <section class="flex flex-col gap-4 border-t border-[var(--border)] pt-6">
      <h2 class="text-[11px] tracking-[0.08em] text-[var(--muted)] uppercase">
        Recommendations
      </h2>
      <div class="min-h-[100px]">
        <!-- Recommendations will be added later -->
      </div>
    </section>
  </div>
</Layout>

<style>
  :global(.glass-row-date) {
    font-size: var(--size-meta);
    color: var(--muted-strong);
    font-variant-numeric: tabular-nums;
  }

  :global(.glass-row-title) {
    font-size: var(--size-body);
    transition: color 0.2s var(--easing);
  }

  :global(.glass-row:hover .glass-row-title) {
    color: var(--accent);
  }
</style>

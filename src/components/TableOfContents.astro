---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="mb-8 animate">
    <h2 class="mb-2 text-sm font-semibold text-black dark:text-white">Table of Contents</h2>
    <ol class="space-y-1 text-sm text-black/60 dark:text-white/60">
      {filteredHeadings.map((heading) => (
        <li style={`padding-left: ${(heading.depth - 1) * 0.75}rem`}>
          <a href={`#${heading.slug}`} class="hover:text-black dark:hover:text-white">
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

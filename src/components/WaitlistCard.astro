---
import type { CollectionEntry } from "astro:content";
import Card from "./ui/Card.astro";

type Data = CollectionEntry<"waitlist">["data"];

interface Props extends Omit<Data, "draft"> {
  href?: string;
  randomBackgroundColor?: boolean;
}

const {
  title,
  description,
  image,
  waitlistURL,
  status,
  href,
  randomBackgroundColor,
} = Astro.props;

// Generate a random pastel color for this card if needed
function generateRandomPastelColor() {
  const hue = Math.floor(Math.random() * 360);
  const saturation = Math.floor(Math.random() * 30) + 10;
  const lightness = Math.floor(Math.random() * 20) + 70;
  return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
}

// Generate a consistent color for this card instance
let cardColor = '';
if (randomBackgroundColor) {
  cardColor = generateRandomPastelColor();
}

// Generate a unique ID for this card to ensure consistent colors
const cardId = `card-${Math.random().toString(36).substring(2, 9)}`;
---

<a
  href={href}
  class="block transition-colors duration-300 ease-in-out hover:bg-black/5 dark:hover:bg-white/5"
>
  <Card id={cardId} class={randomBackgroundColor ? "random-bg-card" : undefined} style={cardColor ? `background-color: ${cardColor}` : undefined}>
    <div class="flex flex-col sm:h-42 sm:flex-row">
      <!-- Main Content -->
      <div class="flex flex-1 flex-col gap-2 p-4">
        <h3 class="font-semibold">{title}</h3>
        <p class="text-sm">{description}</p>

        <!-- Status and Actions -->
        <div class="mt-2 flex flex-wrap items-center gap-3">
          {
            status && (
              <span class="inline-flex items-center rounded-full border border-black/15 px-2 py-0.5 text-xs font-medium dark:border-white/20">
                {status}
              </span>
            )
          }
          {
            waitlistURL && (
              <span class="underline decoration-black/30 underline-offset-[3px] hover:decoration-black/50 dark:decoration-white/30 dark:hover:decoration-white/50">
                View details
              </span>
            )
          }
        </div>
      </div>

      <!-- Right Image -->
      {
        image && (
          <div class="flex flex-shrink-0 items-center justify-center p-4 sm:w-32 sm:p-4">
            <img
              src={image}
              alt={title}
              class="h-24 w-24 rounded-md object-contain sm:h-28 sm:w-28"
              loading="lazy"
            />
          </div>
        )
      }
    </div>
  </Card>
</a>

{randomBackgroundColor && (
  <script define:vars={{ cardId }}>
    // Function to generate a random pastel color
    function generateRandomPastelColor() {
      const hue = Math.floor(Math.random() * 360);
      const saturation = Math.floor(Math.random() * 30) + 10;
      const lightness = Math.floor(Math.random() * 20) + 70;
      return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
    }

    // Apply color when the script runs
    function applyColor() {
      const card = document.getElementById(cardId);
      if (card && !card.style.backgroundColor) {
        card.style.backgroundColor = generateRandomPastelColor();
      }
    }

    // Apply color immediately
    applyColor();

    // Also apply color when the page is navigated to (for Astro's client-side navigation)
    document.addEventListener('astro:page-load', applyColor);
    document.addEventListener('astro:after-preparation', applyColor);
  </script>
)}

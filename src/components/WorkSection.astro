---
import type { CollectionEntry } from "astro:content";
import WorkRow from "@components/WorkRow.astro";
import { formatSurfaceLabel, sortWorks } from "@lib/works";

interface Props {
  works: CollectionEntry<"works">[];
}

const { works } = Astro.props;

// How many rows each group shows up front; a random count in [min, max] is
// picked per group — again at runtime on every load, with the build-time
// pick below as the no-JS fallback. The group's ★ row always stays visible.
const VISIBLE_ROWS = { min: 2, max: 3 } as const;

const scales = [
  {
    id: "product",
    title: "Products",
    sub: "months of work",
    moreLabel: "products",
  },
  {
    id: "tool",
    title: "Tools & libraries",
    sub: "things you install",
    moreLabel: "tools",
  },
  {
    id: "model",
    title: "Models & ports",
    sub: "weights, forks, low-level",
    moreLabel: "models",
  },
  {
    id: "experiment",
    title: "Experiments & hackathons",
    sub: "days to weeks",
    moreLabel: "experiments",
  },
] as const;

const displayRows = (scale: (typeof scales)[number]["id"]) =>
  sortWorks(works.filter((work) => work.data.scale === scale));

const labelsFor = (work: CollectionEntry<"works">) =>
  [
    formatSurfaceLabel(work.data.labels.surface),
    work.data.stack.length === 1 ? work.data.stack[0] : undefined,
    work.data.labels.runtime,
    work.data.labels.source,
  ].filter((label): label is string => Boolean(label));

type Work = CollectionEntry<"works">;

const randomInt = (min: number, max: number) =>
  min + Math.floor(Math.random() * (max - min + 1));

const shuffle = <T,>(items: T[]) => {
  const copy = [...items];
  for (let i = copy.length - 1; i > 0; i -= 1) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
};

// The build-time pick: the group's featured row (one ★ per group) plus a
// random fill from the rest, `min`–`max` rows total. Active statuses are in
// the random mix; archived works only fill leftover slots (and always sort
// last, both here and under "N more …").
const pickVisible = (rows: Work[], featured: Work | undefined) => {
  const count = Math.min(
    rows.length,
    randomInt(VISIBLE_ROWS.min, VISIBLE_ROWS.max),
  );
  const rest = rows.filter((row) => row !== featured);
  const pool = [
    ...shuffle(rest.filter((row) => row.data.status !== "archived")),
    ...shuffle(rest.filter((row) => row.data.status === "archived")),
  ];
  const fill = pool.slice(0, Math.max(0, count - (featured ? 1 : 0)));
  return new Set<Work>(featured ? [featured, ...fill] : fill);
};
---

<section id="work" class="work-section">
  <div class="section-head">
    <h2>Work <small>★ highlighted</small></h2>
  </div>
  <p class="anno">
    Work rows are authored in content/works/*/index.md. The grouped scale,
    status, labels, stack and highlight proof are owner-authored; repo facts are
    resolved from src/data/repos.json on each work page. Each group keeps one ★
    row and shows a random {VISIBLE_ROWS.min}–{VISIBLE_ROWS.max} rows (re-rolled on
    every load); the rest collapse into "N more …".
  </p>
  <div class="groups">
    {
      scales.map((scale) => {
        const rows = displayRows(scale.id);
        // One ★ per group: the first highlighted row by highlight.order.
        const featured = rows.find((work) => work.data.highlight);
        const shown = pickVisible(rows, featured);
        const visible = rows.filter((work) => shown.has(work));
        const more = rows.filter((work) => !shown.has(work));

        return (
          <div
            class="group"
            data-work-group
            data-min={VISIBLE_ROWS.min}
            data-max={VISIBLE_ROWS.max}
          >
            <h3>
              {scale.title} <small>{scale.sub}</small>
            </h3>
            <ul class="rows" data-visible>
              {visible.map((work) => (
                <WorkRow
                  work={work}
                  starred={work === featured}
                  labels={labelsFor(work)}
                />
              ))}
            </ul>
            <details hidden={more.length === 0}>
              <summary>
                <span data-more-count>{more.length}</span> more{" "}
                {scale.moreLabel}
              </summary>
              <ul class="rows" data-more>
                {more.map((work) => (
                  <WorkRow
                    work={work}
                    starred={false}
                    labels={labelsFor(work)}
                  />
                ))}
              </ul>
            </details>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  const initializeWorkGroups = () => {
    document
      .querySelectorAll<HTMLElement>("[data-work-group]")
      .forEach((group) => {
        const min = Number(group.dataset.min ?? 2);
        const max = Number(group.dataset.max ?? 3);
        const visible = group.querySelector<HTMLElement>("[data-visible]");
        const more = group.querySelector<HTMLElement>("[data-more]");
        const details = group.querySelector<HTMLDetailsElement>("details");
        const countEl = group.querySelector<HTMLElement>("[data-more-count]");
        if (!visible || !more || !details || !countEl) return;

        const rows = [
          ...visible.querySelectorAll<HTMLElement>(":scope > li"),
          ...more.querySelectorAll<HTMLElement>(":scope > li"),
        ];
        if (rows.length === 0) return;

        const starred = rows.filter((row) => row.classList.contains("starred"));
        const rest = rows.filter((row) => !row.classList.contains("starred"));
        const shuffleRows = (items: HTMLElement[]) => {
          for (let i = items.length - 1; i > 0; i -= 1) {
            const j = Math.floor(Math.random() * (i + 1));
            [items[i], items[j]] = [items[j], items[i]];
          }
          return items;
        };
        // Active statuses join the random mix; archived rows only fill
        // leftover slots so they stay at the end.
        const pool = [
          ...shuffleRows(
            rest.filter((row) => row.dataset.status !== "archived"),
          ),
          ...shuffleRows(
            rest.filter((row) => row.dataset.status === "archived"),
          ),
        ];

        const count = Math.min(
          rows.length,
          min + Math.floor(Math.random() * (max - min + 1)),
        );
        const chosen = new Set([
          ...starred.slice(0, count),
          ...pool.slice(0, Math.max(0, count - starred.length)),
        ]);

        for (const row of rows) {
          (chosen.has(row) ? visible : more).appendChild(row);
        }
        countEl.textContent = String(more.children.length);
        details.hidden = more.children.length === 0;
      });
  };

  document.addEventListener("astro:page-load", initializeWorkGroups);
  initializeWorkGroups();
</script>

<style>
  .work-section {
    padding: 34px 0 8px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    color: var(--fg);
    font: 650 22px/1.1 var(--display);
    letter-spacing: -0.02em;
  }

  h2 small {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font: 500 12px var(--text);
    font-style: normal;
  }

  .groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px 48px;
  }

  .group h3 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 18px 0 4px;
    color: var(--fg);
    font-family: var(--display);
    font-size: 14px;
    font-weight: 700;
  }

  .group h3 small {
    color: var(--muted);
    font-weight: 500;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  details > summary {
    padding: 12px 0;
    color: var(--muted-strong);
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    list-style: none;
  }

  details > summary::-webkit-details-marker {
    display: none;
  }

  details > summary::before {
    content: "+ ";
  }

  details[open] > summary::before {
    content: "− ";
  }

  details[open] > summary {
    color: var(--fg);
  }

  @media (min-width: 760px) {
    h2 small {
      display: inline;
      margin: 0 0 0 10px;
    }
  }
</style>

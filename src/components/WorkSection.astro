---
import type { CollectionEntry } from "astro:content";
import WorkRow from "@components/WorkRow.astro";
import { formatSurfaceLabel, sortWorks } from "@lib/works";

interface Props {
  works: CollectionEntry<"works">[];
}

const { works } = Astro.props;

const scales = [
  {
    id: "product",
    title: "Products",
    sub: "months of work",
    visible: 4,
    moreLabel: "products",
  },
  {
    id: "tool",
    title: "Tools & libraries",
    sub: "things you install",
    visible: 4,
    moreLabel: "tools",
  },
  {
    id: "model",
    title: "Models & ports",
    sub: "weights, forks, low-level",
    visible: 3,
    moreLabel: "models",
  },
  {
    id: "experiment",
    title: "Experiments & hackathons",
    sub: "days to weeks",
    visible: 2,
    moreLabel: "experiments",
  },
] as const;

const displayRows = (scale: (typeof scales)[number]["id"]) =>
  sortWorks(works.filter((work) => work.data.scale === scale));

const labelsFor = (work: CollectionEntry<"works">) =>
  [
    formatSurfaceLabel(work.data.labels.surface),
    work.data.stack.length === 1 ? work.data.stack[0] : undefined,
    work.data.labels.runtime,
    work.data.labels.source,
  ].filter((label): label is string => Boolean(label));
---

<section id="work" class="work-section">
  <div class="section-head">
    <h2>Work <small>★ highlighted</small></h2>
  </div>
  <p class="anno">
    Work rows are authored in content/works/*/index.md. The grouped scale,
    status, labels, stack and highlight proof are owner-authored; repo facts are
    resolved from src/data/repos.json on each work page.
  </p>
  <div class="groups">
    {
      scales.map((scale) => {
        const rows = displayRows(scale.id);
        const visible = rows.slice(0, scale.visible);
        const more = rows.slice(scale.visible);

        return (
          <div class="group">
            <h3>
              {scale.title} <small>{scale.sub}</small>
            </h3>
            <ul class="rows">
              {visible.map((work) => (
                <WorkRow work={work} labels={labelsFor(work)} />
              ))}
            </ul>
            {more.length > 0 && (
              <details>
                <summary>
                  {more.length} more {scale.moreLabel}
                </summary>
                <ul class="rows">
                  {more.map((work) => (
                    <WorkRow work={work} labels={labelsFor(work)} />
                  ))}
                </ul>
              </details>
            )}
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .work-section {
    padding: 34px 0 8px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    color: var(--fg);
    font: 650 22px/1.1 var(--display);
    letter-spacing: -0.02em;
  }

  h2 small {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font: 500 12px var(--text);
    font-style: normal;
  }

  .groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px 48px;
  }

  .group h3 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 18px 0 4px;
    color: var(--fg);
    font-family: var(--display);
    font-size: 14px;
    font-weight: 700;
  }

  .group h3 small {
    color: var(--muted);
    font-weight: 500;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  details > summary {
    padding: 12px 0;
    color: var(--muted-strong);
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    list-style: none;
  }

  details > summary::-webkit-details-marker {
    display: none;
  }

  details > summary::before {
    content: "+ ";
  }

  details[open] > summary::before {
    content: "− ";
  }

  details[open] > summary {
    color: var(--fg);
  }

  @media (min-width: 760px) {
    h2 small {
      display: inline;
      margin: 0 0 0 10px;
    }

    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import {
  HouseIcon,
  ReadCvLogoIcon,
  FolderOpenIcon,
  UserIcon,
} from "@phosphor-icons/react";

interface NavItem {
  href: string;
  label: string;
  icon: typeof HouseIcon;
}

const navItems: NavItem[] = [
  { href: "/", label: "Home", icon: HouseIcon },
  { href: "/posts", label: "Posts", icon: ReadCvLogoIcon },
  { href: "/projects", label: "Projects", icon: FolderOpenIcon },
  { href: "/about", label: "About", icon: UserIcon },
];

const currentPath = Astro.url.pathname;
---

{/* Desktop Sidebar */}
<nav
  class="sticky top-0 hidden h-screen w-14 flex-col items-center justify-between py-4 min-[661px]:flex"
  aria-label="Main navigation"
>
  <div class="flex flex-col items-center gap-1">
    {
      navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);
        const Icon = item.icon;
        return (
          <a
            href={item.href}
            class:list={[
              "group relative z-50 flex h-10 w-10 items-center justify-center rounded-[10px] no-underline [transition:color_0.25s_var(--easing)] hover:text-(--accent)",
              isActive ? "text-(--accent)" : "text-(--muted)",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            <span class="flex items-center justify-center [transition:transform_0.3s_var(--spring)] group-hover:rotate-[-5deg]">
              <Icon size={22} weight={isActive ? "fill" : "regular"} />
            </span>
            <span class="pointer-events-none absolute top-1/2 left-[calc(100%+10px)] -translate-x-1 -translate-y-1/2 rounded-md border border-(--border) bg-(--bg-elevated) px-2.5 py-1 text-[13px] whitespace-nowrap text-(--fg) opacity-0 shadow-[0_2px_8px_rgba(0,0,0,0.08)] [transition:opacity_0.25s_var(--easing),transform_0.3s_var(--spring)] group-hover:translate-x-0 group-hover:opacity-100">
              {item.label}
            </span>
          </a>
        );
      })
    }
  </div>
</nav>

{/* Mobile Bottom Nav */}
<nav
  class="fixed top-4 right-0 left-0 z-100 hidden justify-center max-[660px]:flex"
  aria-label="Main navigation"
>
  <div
    class="pointer-events-auto flex items-center gap-0.5 rounded-full border border-(--glass-border) bg-(--glass-bg) px-2.5 py-1.5 shadow-(--glass-shadow) [backdrop-filter:var(--glass-blur)] [-webkit-backdrop-filter:var(--glass-blur)]"
  >
    {
      navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);
        const Icon = item.icon;
        return (
          <a
            href={item.href}
            class:list={[
              "pointer-events-auto flex h-10 w-10 items-center justify-center rounded-full bg-transparent no-underline [transition:color_0.25s_var(--easing),background_0.25s_var(--easing)] hover:text-(--accent)",
              isActive
                ? "bg-(--accent-soft) text-(--accent)"
                : "text-(--muted)",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            <Icon size={22} weight={isActive ? "fill" : "regular"} />
          </a>
        );
      })
    }
  </div>
</nav>

---
import { SITE } from "@consts";
---

<aside class="newsletter" aria-label="Newsletter">
  <span class="mark" aria-hidden="true">✳</span>
  <div>
    <h2>Newsletter</h2>
    <p>
      Notes on building agentic AI products, straight to your inbox.
      <a href={SITE.NEWSLETTER_URL} data-track="newsletter_cta">
        Read the newsletter →
      </a>
    </p>
  </div>
</aside>

<style>
  .newsletter {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 20px 0;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-elevated);
  }

  .mark {
    color: var(--accent);
    font-size: 19px;
    line-height: 1.2;
  }

  h2 {
    margin: 0;
    font: 650 14px/1.3 var(--display);
  }

  p {
    margin: 2px 0 0;
    color: var(--fg-soft);
    font-size: 13px;
    line-height: 1.5;
  }

  a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
  }

  a:hover {
    color: var(--fg);
  }
</style>

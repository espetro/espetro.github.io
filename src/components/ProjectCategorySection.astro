---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  title?: string;
  description?: string;
  projects: CollectionEntry<"projects">[];
  id?: string;
  showImage?: boolean;
  showArrow?: boolean;
}

const {
  title,
  description,
  projects,
  id,
  showImage = false,
  showArrow = false,
} = Astro.props;
---

{
  projects.length > 0 && (
    <section class="animate space-y-4" id={id}>
      {title && description && (
        <div class="space-y-1">
          <h2 class="font-semibold text-(--size-h2) dark:text-white">
            {title}
          </h2>
          <p class="text-sm text-(--muted)">{description}</p>
        </div>
      )}
      <div class="flex flex-col gap-2">
        {projects.map((project) => (
          <ProjectCard
            project={project}
            showImage={showImage}
            showArrow={showArrow}
          />
        ))}
      </div>
    </section>
  )
}

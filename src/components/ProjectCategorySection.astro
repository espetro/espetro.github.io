---
import ProjectCard from "./ProjectCard.astro";

interface Project {
  id: string;
  data: {
    title: string;
    description: string;
    date: Date;
    category: string;
    tech: string[];
    image?: string;
  };
}

interface Props {
  title: string;
  description: string;
  projects: Project[];
  id?: string;
  showImage?: boolean;
  showArrow?: boolean;
}

const { title, description, projects, id, showImage = false, showArrow = false } = Astro.props;
---

{
  projects.length > 0 && (
    <section class="animate space-y-4" id={id}>
      <div class="space-y-1">
        <h2 class="text-[var(--size-h2)] font-semibold text-black dark:text-white">
          {title}
        </h2>
        <p class="text-sm text-[var(--muted)]">{description}</p>
      </div>
      <div class="flex flex-col gap-2">
        {projects.map((project) => (
          <ProjectCard
            project={project}
            showImage={showImage}
            showArrow={showArrow}
          />
        ))}
      </div>
    </section>
  )
}

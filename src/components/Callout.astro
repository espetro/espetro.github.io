---
interface Props {
  type?: "info" | "warning" | "tip";
}

const { type = "info" } = Astro.props;

const styles: Record<string, { bg: string; border: string; icon: string }> = {
  info: {
    bg: "rgba(59, 130, 246, 0.1)",
    border: "rgb(59, 130, 246)",
    icon: "ℹ️",
  },
  warning: {
    bg: "rgba(234, 179, 8, 0.1)",
    border: "rgb(234, 179, 8)",
    icon: "⚠️",
  },
  tip: {
    bg: "rgba(34, 197, 94, 0.1)",
    border: "rgb(34, 197, 94)",
    icon: "💡",
  },
};

const style = styles[type];
---

<div
  class="callout my-4 flex gap-2 rounded-md bg-(--bg) p-4 text-[15px] leading-relaxed text-(--fg)"
  style={`--bg: ${style.bg}; --border: ${style.border};`}
>
  <span class="callout-icon shrink-0 text-[1.25em]">{style.icon}</span>
  <div class="callout-content flex-1">
    <slot />
  </div>
</div>

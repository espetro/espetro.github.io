---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const categoryPill = (category: string) => {
  const styles: Record<string, { bg: string; text: string; label: string }> = {
    "front-burner": {
      bg: "var(--accent-soft)",
      text: "var(--accent)",
      label: "FRONT BURNER",
    },
    "back-burner": {
      bg: "rgba(234, 179, 8, 0.1)",
      text: "rgb(234, 179, 8)",
      label: "BACK BURNER",
    },
    retired: {
      bg: "rgba(107, 114, 128, 0.1)",
      text: "rgb(107, 114, 128)",
      label: "RETIRED",
    },
  };
  return styles[category] ?? styles["retired"];
};

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "short" });

const pill = categoryPill(project.data.category);
---

<div class="flex min-w-0 flex-1 flex-col gap-1">
  <h3 class="m-0 font-semibold text-(--fg)">
    {project.data.title}
  </h3>
  <p class="m-0 line-clamp-2 leading-normal text-(--size-meta)">
    {project.data.description}
  </p>
  <div class="flex flex-wrap items-center gap-2 text-(--size-micro)">
    <span
      class="inline-block rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-wider whitespace-nowrap uppercase"
      style={`background-color: ${pill.bg}; color: ${pill.text};`}
    >
      {pill.label}
    </span>
    <span class="whitespace-nowrap text-(--muted)"
      >{formatDate(project.data.date)}</span
    >
    {
      project.data.tech.length > 0 && (
        <>
          <span class="whitespace-nowrap text-(--muted)">·</span>
          <span class="whitespace-nowrap text-(--muted)">
            {project.data.tech.join(", ")}
          </span>
        </>
      )
    }
  </div>
</div>

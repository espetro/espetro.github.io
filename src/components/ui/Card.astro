---
interface Props {
  style?: string;
  class?: string;
  id?: string;
}

const { style, class: className, id } = Astro.props;
// Card component following shadcn design patterns
// Provides a container with proper border, background, and rounded corners
---

<div
  class="rounded-lg border border-black/15 dark:border-white/20"
  class:list={[
    !style && "bg-white dark:bg-black/50",
    className
  ]}
  style={style}
  id={id}
>
  <slot />
</div>

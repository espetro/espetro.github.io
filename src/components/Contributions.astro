---
import contributions from "@data/contributions.json";

interface Contribution {
  title: string;
  url: string;
  repo: string;
  stars: number;
  additions: number;
  deletions: number;
  comments: number;
  state: "merged" | "open";
  updatedAt: string;
}

const fmtStars = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k` : `${n}`;

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const sorted = [...(contributions as Contribution[])].sort(
  (a, b) => +new Date(b.updatedAt) - +new Date(a.updatedAt),
);

const owner = (repo: string) => repo.split("/")[0];
const VISIBLE = 3;
const pages = Math.max(1, sorted.length - VISIBLE + 1);
---

<section id="contributions" class="my-10">
  <h2 class="mb-4 text-[19px] font-semibold text-(--fg)">Contributions</h2>

  <div
    class="contrib-carousel"
    data-visible={VISIBLE}
    data-autoplay="4000"
    tabindex="0"
    aria-label="Open-source contributions"
  >
    <div class="contrib-viewport overflow-hidden">
      <div
        class="contrib-track flex flex-col will-change-transform [transition:transform_0.6s_cubic-bezier(0.32,0.72,0,1),opacity_0.3s_cubic-bezier(0.32,0.72,0,1),filter_0.3s_cubic-bezier(0.32,0.72,0,1)]"
      >
        {
          sorted.map((c, i) => (
            <a
              href={c.url}
              class="contrib-item group flex items-center gap-4 rounded-[10px] border border-transparent bg-transparent p-3 text-inherit no-underline hover:border-(--glass-border) hover:bg-(--glass-active-bg) hover:shadow-[var(--glass-shadow),var(--glass-inset)] hover:backdrop-blur-md [transition:background-color_0.3s_var(--easing),border-color_0.3s_var(--easing),box-shadow_0.3s_var(--easing),backdrop-filter_0.3s_var(--easing)]"
              aria-hidden={i >= VISIBLE ? "true" : undefined}
            >
              <img
                src={`https://github.com/${owner(c.repo)}.png?size=80`}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                class="size-10 shrink-0 rounded-full border border-(--border)"
              />
              <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="flex items-baseline gap-2">
                  <span class="truncate text-[14px] font-semibold text-(--fg)">
                    {c.repo}
                  </span>
                  <span class="shrink-0 text-[12px] text-(--accent)">
                    ★ {fmtStars(c.stars)}
                  </span>
                  <span
                    class={`shrink-0 rounded-md px-[0.4em] py-[0.1em] text-[11px] font-medium whitespace-nowrap ${
                      c.state === "merged"
                        ? "border border-[color-mix(in_srgb,var(--accent)_20%,transparent)] bg-(--accent-soft) text-(--accent)"
                        : "border border-(--border) text-(--muted)"
                    }`}
                  >
                    {c.state}
                  </span>
                </span>
                <span class="truncate text-[13px] text-(--muted)">
                  {c.title}
                </span>
                <span class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-[12px] text-(--muted)">
                  <span>
                    <span class="text-(--fg-soft)">+{c.additions}</span>
                    {" / "}
                    <span class="text-(--fg-soft)">−{c.deletions}</span>
                  </span>
                  <span>💬 {c.comments}</span>
                  <span>{fmtDate(c.updatedAt)}</span>
                </span>
              </span>
              <span
                class="shrink-0 text-[15px] text-(--muted) [transition:color_0.2s_var(--easing),transform_0.2s_var(--easing)] group-hover:translate-x-0.5 group-hover:text-(--accent) max-sm:hidden"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>

    {
      pages > 1 && (
        <div
          class="contrib-dots mt-3 flex items-center justify-center gap-2"
          role="tablist"
          aria-label="Contribution pages"
        >
          {Array.from({ length: pages }).map((_, p) => (
            <button
              type="button"
              class="contrib-dot h-1.5 w-1.5 cursor-pointer rounded-full border-none bg-(--border) p-0 [transition:background-color_0.3s_cubic-bezier(0.32,0.72,0,1),width_0.3s_cubic-bezier(0.32,0.72,0,1)]"
              aria-label={`Show contributions ${p + 1} to ${Math.min(p + VISIBLE, sorted.length)}`}
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>(".contrib-carousel");
  if (root) {
    const track = root.querySelector<HTMLElement>(".contrib-track")!;
    const items = [...root.querySelectorAll<HTMLElement>(".contrib-item")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>(".contrib-dot")];
    const visible = Number(root.dataset.visible ?? 3);
    const autoplay = Number(root.dataset.autoplay ?? 4000);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const maxIndex = Math.max(0, items.length - visible);

    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const render = () => {
      const offset = items[index]?.offsetTop ?? 0;
      track.style.transform = `translateY(${-offset}px)`;
      dots.forEach((d, i) => {
        d.classList.toggle("bg-(--accent)", i === index);
        d.classList.toggle("bg-(--border)", i !== index);
        d.classList.toggle("w-4", i === index);
        d.classList.toggle("w-1.5", i !== index);
        d.setAttribute("aria-selected", String(i === index));
      });
      items.forEach((it, i) =>
        it.setAttribute(
          "aria-hidden",
          i < index || i >= index + visible ? "true" : "false",
        ),
      );
    };

    const go = (next: number) => {
      index = ((next % (maxIndex + 1)) + maxIndex + 1) % (maxIndex + 1);
      render();
    };

    const start = () => {
      if (reduced.matches || timer || maxIndex === 0) return;
      timer = setInterval(() => {
        track.style.opacity = "0.3";
        track.style.filter = "blur(3px)";
        setTimeout(() => {
          go(index + 1);
          track.style.opacity = "1";
          track.style.filter = "blur(0)";
        }, 300);
      }, autoplay);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };

    dots.forEach((d, i) =>
      d.addEventListener("click", () => {
        stop();
        go(i);
      }),
    );
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);

    if (reduced.matches) {
      track.style.transition = "none";
      items.forEach((it) => it.removeAttribute("aria-hidden"));
      root.querySelector(".contrib-dots")?.remove();
    } else {
      render();
      start();
    }

    reduced.addEventListener("change", (e) => {
      if ((e.target as MediaQueryList).matches) {
        stop();
        track.style.transition = "none";
        track.style.transform = "none";
        track.style.opacity = "1";
        track.style.filter = "none";
        items.forEach((it) => it.removeAttribute("aria-hidden"));
      } else {
        track.style.transition = "";
        render();
        start();
      }
    });
  }
</script>

<style>
  .contrib-viewport {
    /* exactly 3 rows visible; row height measured from first item */
    max-height: calc(3 * var(--contrib-row-h, 96px));
  }
  @media (prefers-reduced-motion: reduce) {
    .contrib-viewport {
      max-height: none;
    }
    .contrib-track {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // measure real row height for the viewport clamp
  const vp = document.querySelector<HTMLElement>(".contrib-viewport");
  const first = document.querySelector<HTMLElement>(".contrib-item");
  if (vp && first) {
    const h = first.getBoundingClientRect().height;
    vp.style.setProperty("--contrib-row-h", `${h}px`);
  }
</script>

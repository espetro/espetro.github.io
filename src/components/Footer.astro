---
import { SITE, SOCIALS } from "@consts";

const email = SITE.EMAIL;
const github = SOCIALS.find((s) => s.NAME === "GitHub")?.HREF ?? "#";
const twitter = SOCIALS.find((s) => s.NAME === "Twitter")?.HREF ?? "#";
const rss = "/rss.xml";
---

<footer class="footer">
  <div class="inner">
    <span class="copyright">&copy; 2025</span>
    <nav class="links" aria-label="Footer navigation">
      <a href={`mailto:${email}`}>Email</a>
      <a href={twitter} target="_blank" rel="noopener noreferrer">X.com</a>
      <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={rss} target="_blank" rel="noopener noreferrer">RSS</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-4);
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .copyright {
    font-size: var(--size-micro);
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .links a {
    font-size: var(--size-micro);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s var(--easing);
  }

  .links a:hover {
    color: var(--accent);
  }
</style>

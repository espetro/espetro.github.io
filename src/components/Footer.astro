---
import { SITE, SOCIALS } from "@consts";

const github = SOCIALS.find((s) => s.NAME === "GitHub")?.HREF ?? "#";
const twitter = SOCIALS.find((s) => s.NAME === "Twitter")?.HREF ?? "#";
const linkedin = SOCIALS.find((s) => s.NAME === "LinkedIn")?.HREF ?? "#";

const currentYear = new Date().getFullYear();

interface Link {
  title: string;
  href: string;
}

const LINKS: Link[] = [
  { title: "Email", href: `mailto:${SITE.EMAIL}` },
  { title: "LinkedIn", href: linkedin },
  { title: "X.com", href: twitter },
  { title: "GitHub", href: github },
  { title: "RSS", href: `/rss.xml` },
];
---

<footer class="border-t border-(--border) py-6">
  <div class="flex flex-col items-center gap-2">
    <nav
      class="flex flex-wrap justify-center gap-4"
      aria-label="Footer navigation"
    >
      {
        LINKS.map(({ title, href }) => (
          <a
            href={href}
            target="_blank"
            class="text-[11px] text-[var(--muted)] no-underline [transition:color_0.3s_var(--easing)] hover:text-[var(--accent)]"
          >
            {title}
          </a>
        ))
      }
    </nav>
    <span class="text-[11px] text-[var(--muted)]">&copy; {currentYear}</span>
  </div>
</footer>

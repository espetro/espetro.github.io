---
import { SITE, SOCIALS } from "@consts";

const email = SITE.EMAIL;
const github = SOCIALS.find((s) => s.NAME === "GitHub")?.HREF ?? "#";
const twitter = SOCIALS.find((s) => s.NAME === "Twitter")?.HREF ?? "#";
const linkedin = SOCIALS.find((s) => s.NAME === "LinkedIn")?.HREF ?? "#";
const rss = "/rss.xml";
---

<footer class="footer">
  <div class="inner">
    <nav class="links" aria-label="Footer navigation">
      <a href={`mailto:${email}`}>Email</a>
      <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={twitter} target="_blank" rel="noopener noreferrer">X.com</a>
      <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={rss}>RSS</a>
    </nav>
    <span class="copyright">&copy; {new Date().getFullYear()}</span>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-4);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .links a {
    font-size: var(--size-micro);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s var(--easing);
  }

  .links a:hover {
    color: var(--accent);
  }

  .copyright {
    font-size: var(--size-micro);
    color: var(--muted);
    margin-left: 10px;
  }
</style>

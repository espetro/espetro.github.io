---
interface Props {
  date: string;
  title: string;
  href?: string;
  label?: string;
  arrow?: boolean;
  class?: string;
}

const {
  date,
  title,
  href,
  label,
  arrow = true,
  class: className,
} = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class:list={[
        "group grid grid-cols-[96px_1fr_auto] items-center gap-3 rounded-[10px] border border-transparent bg-transparent p-3 text-inherit no-underline",
        "max-sm:grid-cols-[auto_1fr]",
        "hover:border-(--glass-border) hover:bg-(--glass-active-bg) hover:shadow-[var(--glass-shadow),var(--glass-inset)] hover:backdrop-blur-md",
        "[transition:background-color_0.3s_var(--easing),border-color_0.3s_var(--easing),box-shadow_0.3s_var(--easing),backdrop-filter_0.3s_var(--easing)]",
        className,
      ]}
    >
      <span class="text-[13px] whitespace-nowrap text-(--muted) max-sm:col-start-1 max-sm:row-start-1">
        {date}
      </span>
      <span class="max-sm:text-ellipsis-none flex min-w-0 items-center gap-2 overflow-hidden font-semibold text-ellipsis whitespace-nowrap text-(--fg) max-sm:col-start-2 max-sm:row-start-1 max-sm:overflow-visible max-sm:whitespace-normal">
        {title}
        {label && (
          <span class="shrink-0 rounded-md border border-[color-mix(in_srgb,var(--accent)_20%,transparent)] bg-(--accent-soft) px-[0.4em] py-[0.1em] text-[11px] font-medium whitespace-nowrap text-(--accent)">
            {label}
          </span>
        )}
      </span>
      {arrow && (
        <span
          class="shrink-0 text-[15px] text-(--muted) [transition:color_0.2s_var(--easing),transform_0.2s_var(--easing)] group-hover:translate-x-0.5 group-hover:text-(--accent) max-sm:hidden"
          aria-hidden="true"
        >
          →
        </span>
      )}
      <div class="col-span-full">
        <slot />
      </div>
    </a>
  ) : (
    <div
      class:list={[
        "group grid grid-cols-[96px_1fr_auto] items-center gap-3 rounded-[10px] border border-transparent bg-transparent p-3",
        "max-sm:grid-cols-[auto_1fr]",
        "hover:border-(--glass-border) hover:bg-(--glass-active-bg) hover:shadow-[var(--glass-shadow),var(--glass-inset)] hover:backdrop-blur-md",
        "[transition:background-color_0.3s_var(--easing),border-color_0.3s_var(--easing),box-shadow_0.3s_var(--easing),backdrop-filter_0.3s_var(--easing)]",
        className,
      ]}
    >
      <span class="text-[13px] whitespace-nowrap text-(--muted) max-sm:col-start-1 max-sm:row-start-1">
        {date}
      </span>
      <span class="flex min-w-0 items-center gap-2 overflow-hidden font-semibold text-ellipsis whitespace-nowrap text-(--fg) max-sm:col-start-2 max-sm:row-start-1 max-sm:overflow-visible max-sm:whitespace-normal">
        {title}
        {label && (
          <span class="shrink-0 rounded-md border border-[color-mix(in_srgb,var(--accent)_20%,transparent)] bg-(--accent-soft) px-[0.4em] py-[0.1em] text-[11px] font-medium whitespace-nowrap text-(--accent)">
            {label}
          </span>
        )}
      </span>
      {arrow && (
        <span
          class="shrink-0 text-[15px] text-(--muted) [transition:color_0.2s_var(--easing),transform_0.2s_var(--easing)] group-hover:translate-x-0.5 group-hover:text-(--accent) max-sm:hidden"
          aria-hidden="true"
        >
          →
        </span>
      )}
      <div class="col-span-full">
        <slot />
      </div>
    </div>
  )
}

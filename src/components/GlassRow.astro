---
interface Props {
  date: string;
  title: string;
  href?: string;
  class?: string;
}

const { date, title, href, class: className } = Astro.props;
---

{
  href ? (
    <a href={href} class:list={["glass-row", className]}>
      <span class="glass-row-date">{date}</span>
      <span class="glass-row-title">{title}</span>
      <slot />
    </a>
  ) : (
    <div class:list={["glass-row", className]}>
      <span class="glass-row-date">{date}</span>
      <span class="glass-row-title">{title}</span>
      <slot />
    </div>
  )
}

<style>
  .glass-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: center;
    gap: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: transparent;
    transition:
      background-color 0.3s var(--easing),
      border-color 0.3s var(--easing),
      box-shadow 0.3s var(--easing),
      backdrop-filter 0.3s var(--easing);
    text-decoration: none;
    color: inherit;
  }

  .glass-row:hover {
    background-color: var(--glass-active-bg);
    border-color: var(--glass-border);
    box-shadow: var(--glass-shadow), var(--glass-inset);
    backdrop-filter: blur(12px);
  }

  .glass-row-date {
    font-size: var(--size-meta);
    color: var(--muted);
    white-space: nowrap;
  }

  .glass-row-title {
    font-weight: 600;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

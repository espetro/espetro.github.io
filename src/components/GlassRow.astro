---
interface Props {
  date: string;
  title: string;
  href?: string;
  label?: string;
  arrow?: boolean;
  class?: string;
}

const { date, title, href, label, arrow = true, class: className } = Astro.props;
---

{
  href ? (
    <a href={href} class:list={["glass-row", className]} target="_blank" rel="noopener noreferrer">
      <span class="glass-row-date">{date}</span>
      <span class="glass-row-title">
        {title}
        {label && <span class="glass-row-label">{label}</span>}
      </span>
      {arrow && <span class="glass-row-arrow" aria-hidden="true">→</span>}
      <div class="glass-row-extras"><slot /></div>
    </a>
  ) : (
    <div class:list={["glass-row", className]}>
      <span class="glass-row-date">{date}</span>
      <span class="glass-row-title">
        {title}
        {label && <span class="glass-row-label">{label}</span>}
      </span>
      {arrow && <span class="glass-row-arrow" aria-hidden="true">→</span>}
      <div class="glass-row-extras"><slot /></div>
    </div>
  )
}

<style>
  .glass-row {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: transparent;
    transition:
      background-color 0.3s var(--easing),
      border-color 0.3s var(--easing),
      box-shadow 0.3s var(--easing),
      backdrop-filter 0.3s var(--easing);
    text-decoration: none;
    color: inherit;
  }

  .glass-row:hover {
    background-color: var(--glass-active-bg);
    border-color: var(--glass-border);
    box-shadow: var(--glass-shadow), var(--glass-inset);
    backdrop-filter: blur(12px);
  }

  .glass-row-date {
    font-size: var(--size-meta);
    color: var(--muted);
    white-space: nowrap;
  }

  .glass-row-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .glass-row-label {
    font-size: var(--size-micro);
    font-weight: 500;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .glass-row-arrow {
    color: var(--muted);
    font-size: var(--size-body);
    flex-shrink: 0;
    transition: color 0.2s var(--easing), transform 0.2s var(--easing);
  }

  .glass-row:hover .glass-row-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  .glass-row-extras {
    grid-column: 1 / -1;
  }
</style>

---
interface Props {
  term: string;
}

const { term } = Astro.props;
---

<div
  class="giscus"
  data-giscus-root
  data-repo="espetro/espetro.github.io"
  data-repo-id="R_kgDOQ6qq5A"
  data-category="Blog posts"
  data-category-id="DIC_kwDOQ6qq5M4C1AZD"
  data-mapping="specific"
  data-term={term}
  data-strict="1"
  data-reactions-enabled="1"
  data-input-position="top"
  data-lang="en"
  data-loading="lazy"
  aria-label="Comments"
>
</div>

<script>
  const initializeGiscus = () => {
    const root = document.querySelector<HTMLElement>("[data-giscus-root]");
    if (!root || root.dataset.mounted === "true") return;

    root.dataset.mounted = "true";
    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";

    for (const attribute of [
      "repo",
      "repoId",
      "category",
      "categoryId",
      "mapping",
      "term",
      "strict",
      "reactionsEnabled",
      "inputPosition",
      "lang",
      "loading",
    ]) {
      const value = root.dataset[attribute];
      if (!value) continue;
      const name = attribute.replace(
        /[A-Z]/g,
        (letter) => `-${letter.toLowerCase()}`,
      );
      script.setAttribute(`data-${name}`, value);
    }

    script.dataset.theme = document.documentElement.classList.contains("dark")
      ? "dark"
      : "light";
    root.append(script);
  };

  document.addEventListener("astro:page-load", initializeGiscus);
  initializeGiscus();
</script>

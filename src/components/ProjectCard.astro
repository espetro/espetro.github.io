---
import type { CollectionEntry } from "astro:content";
import GlassCard from "./GlassCard.astro";
import ProjectCardContent from "./ProjectCardContent.astro";
import { ArrowRightIcon } from "@phosphor-icons/react";

interface Props {
  project: CollectionEntry<"projects">;
  showImage?: boolean;
  showArrow?: boolean;
}

const { project, showImage = false, showArrow = false } = Astro.props;

const glassCardClass = showImage ? "project-card-image" : "project-card-simple";
---

<GlassCard href={`/projects/${project.id}`} class={glassCardClass}>
  <div class={showImage ? "flex items-center gap-6" : undefined}>
    {
      showImage && project.data.preview && (
        <div class="h-20 w-20 shrink-0 overflow-hidden rounded-[var(--radius-md)] bg-[var(--bg-elevated)]">
          <img
            src={project.data.preview}
            alt={project.data.title}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
    <ProjectCardContent project={project} />
    {
      showArrow && (
        <ArrowRightIcon className="shrink-0 text-[var(--muted)] text-[var(--size-body)] transition-all duration-200 ease-[var(--easing)] group-hover/project-card-image:text-[var(--accent)] group-hover/project-card-image:translate-x-0.5" />
      )
    }
  </div>
</GlassCard>

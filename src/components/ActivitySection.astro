---
import ActivityCalendar from "./ActivityCalendar";
import { fetchGitHubContributions, fetchRecentCommits } from "@lib/github";

const activities = await fetchGitHubContributions("espetro");
const recentCommits = await fetchRecentCommits("espetro");
---

<section class="activity-section">
  <h2 class="section-title">Activity</h2>

  {activities.length === 0 ? (
    <p class="error-message">Unable to load activity</p>
  ) : (
    <>
      <div class="calendar-wrapper">
        <ActivityCalendar data={activities} />
      </div>

      {recentCommits.length > 0 && (
        <div class="commits-list">
          <h3 class="commits-title">Recent Commits</h3>
          <ul class="commits">
            {recentCommits.map((commit) => (
              <li class="commit-item">
                <a
                  href={commit.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="commit-link"
                >
                  <span class="commit-repo">&gt; {commit.repo}</span>
                  {commit.lang && (
                    <span class="commit-lang">[{commit.lang}]</span>
                  )}
                  <span class="commit-sep">—</span>
                  <span class="commit-message">{commit.message}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </>
  )}
</section>

<script is:inline>
  function scrollCalendarToEnd() {
    const wrapper = document.querySelector(".calendar-wrapper");
    if (wrapper) {
      wrapper.scrollLeft = wrapper.scrollWidth;
    }
  }

  // Run on initial load and after view transitions
  document.addEventListener("astro:page-load", scrollCalendarToEnd);

  // Also observe the wrapper for React hydration in case page-load hasn't fired yet
  const wrapper = document.querySelector(".calendar-wrapper");
  if (wrapper) {
    const mo = new MutationObserver(() => {
      scrollCalendarToEnd();
      mo.disconnect();
    });
    mo.observe(wrapper, { childList: true, subtree: true });
  }
</script>

<style>
  .activity-section {
    margin-block: var(--space-5);
  }

  .section-title {
    font-size: var(--size-h2);
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--fg);
  }

  .error-message {
    color: var(--muted);
    font-style: italic;
  }

  .calendar-wrapper {
    margin-bottom: var(--space-4);
    overflow-x: auto;
  }

  .commits-list {
    margin-top: var(--space-4);
  }

  .commits-title {
    font-size: var(--size-meta);
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .commits {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .commit-item {
    margin-bottom: var(--space-1);
  }

  .commit-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: ui-monospace, "SF Mono", Menlo, Monaco, Consolas, monospace;
    font-size: var(--size-meta);
    color: var(--fg-soft);
    text-decoration: none;
    transition: color 0.2s var(--easing);
    flex-wrap: wrap;
    line-height: 1.5;
  }

  .commit-link:hover {
    color: var(--accent);
  }

  .commit-repo {
    color: var(--accent);
    flex-shrink: 0;
  }

  .commit-lang {
    color: var(--muted-strong);
    flex-shrink: 0;
  }

  .commit-sep {
    color: var(--muted);
    flex-shrink: 0;
  }

  .commit-message {
    color: inherit;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

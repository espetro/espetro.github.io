---
// Activity section uses the GitHub Contribution Chart API (ghchart.rshah.org)
// rendered as a static <img> — no server-side fetching or client JS required.
// Accent color #ea580c matches --accent from the site's CSS variables.
const username = "espetro";
const accentColor = "#ea580c";
---

<section class="my-10">
  <h2 class="mb-4 text-[19px] font-semibold text-(--fg)">Activity</h2>

  <div class="overflow-x-auto">
    <img
      src={`https://ghchart.rshah.org/${accentColor.replace("#", "")}/${username}`}
      alt={`${username}'s GitHub contribution chart`}
      class="block h-auto w-full rounded-[10px]"
    />
  </div>
</section>

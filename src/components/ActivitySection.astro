---
// Activity section uses the GitHub Contribution Chart API (ghchart.rshah.org)
// rendered as a static <img> — no server-side fetching or client JS required.
// Accent color #ea580c matches --accent from the site's CSS variables.
const username = "espetro";
const accentColor = "#ea580c";
---

<section class="activity-section">
  <h2 class="section-title">Activity</h2>

  <div class="chart-wrapper">
    <img
      src={`https://ghchart.rshah.org/${accentColor.replace("#", "")}/${username}`}
      alt={`${username}'s GitHub contribution chart`}
      class="github-chart"
      loading="lazy"
    />
  </div>
</section>

<style>
  .activity-section {
    margin-block: var(--space-5);
  }

  .section-title {
    font-size: var(--size-h2);
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--fg);
  }

  .chart-wrapper {
    overflow-x: auto;
  }

  .github-chart {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
</style>

---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class:list={[
        "block overflow-hidden rounded-[10px] border border-(--border) bg-transparent p-4 text-inherit no-underline transition-all duration-300",
        "hover:border-(--glass-border) hover:bg-(--glass-active-bg) hover:shadow-[var(--glass-shadow),var(--glass-inset)] hover:backdrop-blur-md",
        className,
      ]}
    >
      <slot />
    </a>
  ) : (
    <div
      class:list={[
        "block overflow-hidden rounded-[10px] border border-(--border) bg-transparent p-4 text-inherit transition-all duration-300",
        "hover:border-(--glass-border) hover:bg-(--glass-active-bg) hover:shadow-[var(--glass-shadow),var(--glass-inset)] hover:backdrop-blur-md",
        className,
      ]}
    >
      <slot />
    </div>
  )
}

---
import { speaks } from "@data/speaking";
import { SITE } from "@consts";

const hasTalks = speaks.length > 0;
---

<section class="animate mt-16">
  <h2 class="mb-6 font-semibold text-(--font-size-h2)">Speaking</h2>

  {
    hasTalks ? (
      <div class="overflow-hidden rounded-[14px] border border-(--border) bg-(--bg)">
        {speaks.map((speak, i) => (
          <>
            <div class="p-6">
              <span class="mb-1 block font-mono text-[11px] tracking-wider text-(--muted) uppercase">
                {speak.date}
              </span>
              <h4 class="mb-1 font-semibold text-(--fg)">{speak.event}</h4>
              <p class="m-0 leading-relaxed text-(--fg-soft)">{speak.talk}</p>
              {(speak.link || speak.recording) && (
                <div class="mt-2 flex gap-4 text-[13px]">
                  {speak.link && (
                    <a
                      href={speak.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-(--fg) underline decoration-(--border) underline-offset-2 hover:text-(--accent)"
                    >
                      Event
                    </a>
                  )}
                  {speak.recording && (
                    <a
                      href={speak.recording}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-(--fg) underline decoration-(--border) underline-offset-2 hover:text-(--accent)"
                    >
                      Recording
                    </a>
                  )}
                </div>
              )}
            </div>
            {i < speaks.length - 1 && (
              <hr class="m-0 border-0 border-t border-(--border)" />
            )}
          </>
        ))}
      </div>
    ) : (
      <div class="rounded-[14px] border border-(--border) bg-(--bg) p-6">
        <p class="m-0 leading-relaxed text-(--fg-soft)">
          I'm starting to speak about agentic AI engineering. If you're looking
          for a speaker or just want to chat about the topic,{" "}
          <a
            href={`mailto:${SITE.EMAIL}`}
            class="text-(--fg) underline decoration-(--border) underline-offset-2 hover:text-(--accent)"
          >
            reach out
          </a>
          .
        </p>
      </div>
    )
  }
</section>

---
interface Props {
  date: string;
  title: string;
  href?: string;
  class?: string;
}

const { date, title, href, class: className } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class:list={[
        "flex items-center justify-between gap-4 rounded-[10px] border border-[var(--border)] bg-transparent p-4 text-inherit no-underline transition-all duration-300 hover:border-[var(--glass-border)] hover:bg-[var(--glass-active-bg)] hover:shadow-[var(--glass-shadow),_var(--glass-inset)] hover:backdrop-blur-[12px]",
        className,
      ]}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="overflow-hidden font-semibold text-ellipsis whitespace-nowrap text-[var(--fg)]">
        {title}
      </span>
      <span class="flex flex-shrink-0 items-center gap-2">
        <span class="text-[13px] whitespace-nowrap text-[var(--muted)]">
          {date}
        </span>
        <span class="text-[13px] text-[var(--muted)]" aria-hidden="true">
          →
        </span>
      </span>
    </a>
  ) : (
    <div
      class:list={[
        "flex items-center justify-between gap-4 rounded-[10px] border border-[var(--border)] bg-transparent p-4 text-inherit no-underline transition-all duration-300 hover:border-[var(--glass-border)] hover:bg-[var(--glass-active-bg)] hover:shadow-[var(--glass-shadow),_var(--glass-inset)] hover:backdrop-blur-[12px]",
        className,
      ]}
    >
      <span class="overflow-hidden font-semibold text-ellipsis whitespace-nowrap text-[var(--fg)]">
        {title}
      </span>
      <span class="flex flex-shrink-0 items-center gap-2">
        <span class="text-[13px] whitespace-nowrap text-[var(--muted)]">
          {date}
        </span>
        <span class="text-[13px] text-[var(--muted)]" aria-hidden="true">
          →
        </span>
      </span>
    </div>
  )
}

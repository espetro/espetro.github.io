---
const quote =
  "The only way to do great work is to love what you do. — Steve Jobs";
---

<div class="group relative overflow-hidden py-3" aria-label={quote}>
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-linear-to-r from-(--bg) to-transparent motion-reduce:hidden"
    aria-hidden="true"
  >
  </div>

  <div class="overflow-hidden motion-reduce:hidden">
    <div
      class="flex w-max [animation:marquee_100s_linear_infinite] text-[13px] whitespace-nowrap text-(--muted) group-hover:[animation-play-state:paused]"
    >
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
      <span>{quote}</span>
      <span class="px-3" aria-hidden="true"> · </span>
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-linear-to-l from-(--bg) to-transparent motion-reduce:hidden"
    aria-hidden="true"
  >
  </div>

  <p
    class="m-0 hidden text-center text-[13px] text-(--muted) motion-reduce:block"
    aria-hidden="true"
  >
    {quote}
  </p>
</div>

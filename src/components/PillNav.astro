---
import { House, ReadCvLogo, User } from "@phosphor-icons/react";

const path = Astro.url.pathname;
const homeActive = path === "/" || path.startsWith("/projects/");
const logActive = path === "/log" || path.startsWith("/log/");
const aboutActive = path === "/about" || path.startsWith("/about/");
---

<nav class="pill-nav" aria-label="Main navigation">
  <div class="pill">
    <a
      href="/"
      aria-label="Home"
      aria-current={homeActive ? "page" : undefined}
    >
      <House
        size={22}
        weight={homeActive ? "fill" : "regular"}
        aria-hidden="true"
      />
    </a>
    <a
      href="/log"
      aria-label="Log"
      aria-current={logActive ? "page" : undefined}
    >
      <ReadCvLogo
        size={22}
        weight={logActive ? "fill" : "regular"}
        aria-hidden="true"
      />
    </a>
    <a
      href="/about"
      aria-label="About"
      aria-current={aboutActive ? "page" : undefined}
    >
      <User
        size={22}
        weight={aboutActive ? "fill" : "regular"}
        aria-hidden="true"
      />
    </a>
    <span class="separator" aria-hidden="true"></span>
    <button
      class="orb"
      type="button"
      aria-label="Toggle theme"
      data-theme-toggle></button>
  </div>
</nav>

<style>
  .pill-nav {
    position: sticky;
    top: 16px;
    z-index: var(--z-nav);
    display: flex;
    height: 0;
    justify-content: center;
    overflow: visible;
    pointer-events: none;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 2px;
    height: max-content;
    padding: 6px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    box-shadow: 0 4px 24px rgb(0 0 0 / 6%);
    pointer-events: auto;
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
  }

  @media (prefers-reduced-transparency: reduce) {
    .pill {
      background: var(--bg-elevated);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  a {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 999px;
    color: var(--muted);
    transition:
      color 0.25s,
      background 0.25s;
  }

  a:hover {
    color: var(--accent);
  }

  a :global(svg) {
    transition: transform 0.3s var(--spring);
  }

  a:hover :global(svg) {
    transform: rotate(-5deg);
  }

  a[aria-current="page"] {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .separator {
    width: 1px;
    height: 24px;
    margin: 0 4px;
    background: var(--glass-border);
  }

  .orb {
    width: 20px;
    height: 20px;
    margin: 0 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
    cursor: pointer;
    transition:
      box-shadow 0.3s,
      background 0.3s,
      transform 0.5s var(--spring);
  }

  .orb:hover {
    box-shadow: 0 0 0 7px var(--accent-soft);
  }

  :global(.dark) .orb {
    transform: rotate(180deg) scale(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    a :global(svg),
    .orb {
      transition: none;
    }
  }
</style>

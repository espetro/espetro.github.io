---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="bio-section animate">
  <h2>{title}</h2>
  <slot />
</section>

<style>
  .bio-section {
    margin-bottom: var(--space-5);
  }

  .bio-section h2 {
    font-size: var(--size-h2);
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--fg);
  }

  .bio-section p {
    font-size: var(--size-body);
    color: var(--fg-soft);
    line-height: 1.7;
  }
</style>

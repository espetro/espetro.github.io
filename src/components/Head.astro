---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Main from "../scripts/Main.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = "/profile.jpg",
  ogType = "website",
  jsonLd,
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Quino Terrasa",
  url: "https://illo.fyi",
  sameAs: [
    "https://www.linkedin.com/in/quinoterrasa",
    "https://github.com/espetro",
    "https://x.com/josocjoq",
  ],
};
---

<!-- Resource Hints -->
<link rel="preconnect" href="https://giscus.app" />
<link rel="dns-prefetch" href="https://giscus.app" />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />

<!-- RSS Feed -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS Feed"
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title} | Quino Terrasa</title>
<meta name="title" content={`${title} | Quino Terrasa`} />
<meta name="description" content={description} />
<meta name="theme-color" content="#faf9f6" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Structured Data -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(personSchema)}
/>
{
  jsonLd && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  )
}

<ClientRouter />

<script>
  import posthog from "posthog-js";

  const key = import.meta.env.PUBLIC_POSTHOG_KEY;
  if (key) {
    posthog.init(key, {
      api_host:
        import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com",
      cookieless_mode: "always",
      person_profiles: "never",
    });

    document.addEventListener("click", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("[data-track]");
      if (el)
        posthog.capture(el.dataset.track!, { href: el.getAttribute("href") });
    });
  }
</script>

<Main />
